<nav>
	<ul>
		<li webc:for="item of $data.collections.root">
			<a :href="item.url">
				<p @html="item.fileSlug?.replace(/./, firstChar => firstChar.toUpperCase()) || '&'"></p>
			</a>
		</li>
		<li>
			<block :@collection="$data.collections.weeks" @title="Sessions" webc:import="nav-details.webc">
				<p @html="item.data.title"></p>
				<p @text="displayDate(item.data.date)"></p>
			</block>
		</li>
		<li>
			<block :@collection="$data.collections.projects" @title="Projects" webc:import="nav-details.webc">
				<p @html="item.data.title"></p>
				<p @text="displayDate(item.data.date)"></p>
			</block>
		</li>
		<li>
			<block :@collection="$data.collections.topics" @title="Topics" webc:import="nav-details.webc">
				<p @html="item.data.title"></p>
				<p @text="displayDate(item.data.date)"></p>
			</block>
		</li>
	</ul>
</nav>
