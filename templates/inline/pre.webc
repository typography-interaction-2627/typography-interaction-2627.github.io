<style>
	pre {
		--leading: 1rlh;

		background-color: var(--color);
		display:          flex;
		overflow:         auto;
		padding:          1rex;
		scrollbar-width:  none;

		code {
			tab-size: 4;
			color:    var(--background);
			text-box: trim-both cap alphabetic;
		}
	}

	/* In-page. */
	main :is(pre, ti-preview) {
		filter:          saturate(var(--in-view)) contrast(calc(2 - var(--in-view))) brightness(calc(2 - var(--in-view)));
		inline-size:     fit-content;
		max-inline-size: 100%;

		@supports (not (font: -apple-system-body)) and (not (-moz-appearance: none)) {
			border-radius: var(--1px);
			corner-shape:  notch;
		}

		/* TODO Abstract this pattern! */
		@supports (animation-timeline: view()) {
			animation-fill-mode:       both;
			animation-name:            in-view;
			animation-range:           cover;
			animation-timeline:        view();
			animation-timing-function: ease-in-out;
		}

		&:hover {
			--in-view: 1;

			animation-name: none;
		}

		/* For poking out as needed. */
		&.all { max-inline-size: calc(var(--main) - var(--gutter)) }

		&:is(ti-preview) { overflow: clip } /* For the corners; scrolls internally. */
	}

	/* Live preview settings. */
	ti-preview {
		--container-border-radius: initial;

		--container-font-smooth:           never;
		--container-text-rendering:        geometricPrecision;
		--container-webkit-font-smoothing: none;

		--editor-background:           var(--color);
		--editor-border-bottom:        var(--editor-border-top);
		--editor-border-top:           var(--1px) solid var(--color);
		--editor-caret-color:          var(--background);
		--editor-font-family:          'Monaco', monospace;
		--editor-font-size:            calc(var(--size--code) * var(--1px));
		--editor-line-height:          1rlh;
		--editor-padding:              calc(1rex - var(--1px));
		--editor-scrollbar-width:      none;
		--editor-selection-background: color-mix(in srgb, var(--background), transparent 80%);
		--editor-text-box:             trim-both cap alphabetic;
		--editor-width:                var(--body);

		--output-background:            var(--background);
		--output-border:                var(--editor-border-top);
		--output-dimensions-backdrop:   none;
		--output-dimensions-background: var(--background);
		--output-dimensions-box-shadow: var(--shadow--border);
		--output-dimensions-font-size:  calc(9 * var(--1px));
		--output-dimensions-inset:      auto auto var(--output-dimensions-padding) var(--output-dimensions-padding);
		--output-dimensions-padding:    1ex;
		--output-dimensions-text-box:   var(--editor-text-box);

		/* Chrome/Safari `opsz` dance, again; see `typography.css` */
		@supports (not (-moz-appearance: none)) {
			--editor-font-family: 'Monaco 9';

			--output-dimensions-font-family: 'Monaco 9';

			@container style(--tablet) { --editor-font-family: 'Monaco 12' }
		}

		--tab-bar-active-background: var(--background);
		--tab-bar-active-border:     var(--1px) solid transparent;
		--tab-bar-active-foreground: var(--color);
		--tab-bar-active-highlight:  transparent;
		--tab-bar-background:        var(--color);
		--tab-bar-border:            var(--1px) solid var(--background);
		--tab-bar-font-family:       var(--editor-font-family);
		--tab-bar-font-size:         var(--editor-font-size);
		--tab-bar-foreground:        var(--background);
		--tab-bar-hover-foreground:  var(--background);
		--tab-bar-justify:           start;
		--tab-bar-margin:            var(--editor-padding) var(--editor-padding) var(--3px);
		--tab-bar-nav-background:    transparent;
		--tab-bar-nav-box-shadow:    var(--shadow--single);
		--tab-bar-padding:           calc(1rex - var(--1px));
		--tab-bar-text-box:          var(--editor-text-box);

		--syntax-atom:             var(--background);
		--syntax-bool:             dodgerblue;
		--syntax-className:        dodgerblue;
		--syntax-comment:          color-mix(in srgb, var(--background), transparent 50%);
		--syntax-definition:       plum;
		--syntax-deleted:          tomato;
		--syntax-emphasis:         var(--syntax-comment);
		--syntax-heading:          tomato;
		--syntax-inserted:         darkseagreen;
		--syntax-invalid:          var(--background);
		--syntax-keyword:          tomato;
		--syntax-labelName:        cornflowerblue;
		--syntax-link:             mediumorchid;
		--syntax-literal:          lightskyblue;
		--syntax-macroName:        tomato;
		--syntax-meta:             dodgerblue;
		--syntax-namespace:        khaki;
		--syntax-number:           dodgerblue;
		--syntax-operator:         color-mix(in srgb, var(--background), transparent 33%);
		--syntax-propertyName:     dodgerblue;
		--syntax-punctuation:      color-mix(in srgb, var(--background), transparent 33%);
		--syntax-string:           lightskyblue;
		--syntax-strong:           var(--syntax-comment);
		--syntax-text:             var(--background);
		--syntax-typeName:         limegreen;
		--syntax-url:              darkturquoise;
		--syntax-variableName:     orange;
		--syntax-whitespace-space: '';
		--syntax-whitespace-tab:   '';
		--syntax-whitespace:       color-mix(in srgb, var(--background), transparent 85%);
		/* TODO Pixel whitespace characters via `background` variables ! */
	}
</style>
<template webc:nokeep webc:root="override">
	<ti-preview webc:if="!nested" @attributes hide-output hide-tabs>
		<pre>
			<slot></slot>
		</pre>
	</ti-preview>
	<pre webc:else>
		<slot></slot>
	</pre>
</template>
