<style>
	:where(main) {
		:where(details) {
			summary {
				position:         relative;
				background-color: var(--color);
				display:          block;
				inline-size:      fit-content;
				margin-block-end: 1rlh;
				padding:          1ex;

				&::after {
					background:     var(--check);
					content:        '';
					inset:          0;
					mix-blend-mode: multiply;
					position:       absolute;
					translate:      var(--2px) var(--2px);
				}

				p {
					--color: var(--background);

					padding-inline-start: 2ex;
					position:             relative;
					user-select:          none;
					z-index:              1;

					&::before {
						content:            var(--icon, '+') / '';
						inset-inline-start: 0;
						margin-inline-end:  var(--lead);
						position:           absolute;
					}
				}

				+ * { margin-block-start: initial }
			}

			&[open] {
				--icon: '-';

				&::details-content {
					display:               grid;
					grid-column:           all;
					grid-template-columns: subgrid;
					row-gap:               inherit;
				}
			}

			+ * { margin-block-start: 1rlh }
		}
	}

	/* TODO Make this a `details.webc` actually! */
	/* TODO Some way to not to filter slot content? */
</style>
<summary webc:root="override">
	<slot></slot>
</summary>
