<style>
	aside {
		--family: 'Chicago';
		--wrap:   balance;

		background-color:   var(--color);
		border:             var(--2px) solid var(--background);
		display:            grid;
		grid-column:        aside;
		isolation:          isolate;
		outline:            var(--1px) solid var(--color);
		padding:            var(--gutter);
		place-items:        center;
		position:           relative;
		row-gap:            var(--line);
		text-align:         center;

		&::after {
			content:          '';
			position:         absolute;
			background-color: var(--background);
			inset:            var(--2px);
			z-index:          -1;
		}

		/* TODO This pattern could be consolidated! */
		&:where(:not(:first-child)),
		&:where(:not(:last-child)) + * {
			margin-block-start: round(1rlh, var(--1px));

			@container style(--columns: 6) { margin-block-start: round(2rlh, var(--1px)) }
		}
	}
</style>
<aside webc:root="override">
	<slot></slot>
</aside>
