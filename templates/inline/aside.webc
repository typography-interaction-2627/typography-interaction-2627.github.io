<style>
	aside {
		--family:  'Chicago';
		--leading: calc(6 / 5 * 100%); /* Tighten to 1.2 */
		--wrap:    balance;

		--gap: calc(2lh - 1cap);

		background-color: var(--color);
		border:           var(--2px) solid var(--background);
		display:          grid;
		grid-column:      aside;
		isolation:        isolate;
		outline:          var(--1px) solid var(--color);
		padding-block:    max(var(--gutter), var(--gap));
		padding-inline:   var(--gutter);
		place-items:      center;
		position:         relative;
		row-gap:          var(--gap);
		text-align:       center;

		&::after {
			content:          '';
			position:         absolute;
			background-color: var(--background);
			inset:            var(--2px);
			z-index:          -1;
		}

		/* TODO This pattern could be consolidated! */
		&:where(:not(:first-child)),
		&:where(:not(:last-child)) + * {
			margin-block-start: 1rlh;

			@container style(--columns) { margin-block-start: 2rlh }
		}

		sub { --leading: initial }
	}
</style>
<aside webc:root="override">
	<slot></slot>
</aside>
