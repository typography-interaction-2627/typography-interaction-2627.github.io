<style>
	a:has(> cite) {
		inline-size: fit-content;

		cite {
			padding:          round(1ex, var(--1px));
			background-color: var(--color);
			display:          block;
			inline-size:      fit-content;
			color:            var(--background);

			* { --color: var(--background) }
		}
	}
</style>
<cite webc:root="override"><slot></slot></cite>
