<style>
	/* TODO This could be better (”For Next Week”). */
	:where(p, li):has(a > cite):not(:has(ul)) {
		--wrap: balance;

		inline-size:     fit-content; /* Cinch (for `:hover`). */
		max-inline-size: initial;

		> a:has(> cite) {
			--size: var(--size--root);

			inline-size: fit-content;
			isolation:   isolate;

			:where(cite) {
				--padding: 1ex;

				box-shadow:           var(--shadow--border), var(--shadow--single);
				display:              block;
				inline-size:          fit-content;
				margin-inline:        initial;
				padding-block:        var(--padding);
				padding-inline-end:   calc(var(--padding) - var(--right));
				padding-inline-start: calc(var(--padding) - var(--left));
				position:             relative;
				z-index:              1; /* In front of the link enlargement. */
			}
		}

		/* With a note after. */
		> small {
			display:            block;
			margin-block-start: var(---5px);
			text-box:           trim-both cap alphabetic;
		}

		/* Don’t double-inset. */
		> :is(a:has(> cite), small) {
			margin-inline-end:   var(--right);
			margin-inline-start: var(--left);
		}
	}
</style>
<cite webc:root="override"><slot></slot></cite>
