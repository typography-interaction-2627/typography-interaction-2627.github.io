<style>
	/* TODO This could be better (”For Next Week”). */
	:where(p, li):has(a > cite):not(:has(ul)) {
		--wrap: balance;

		inline-size: fit-content; /* Cinch (for `:hover`). */
		max-inline-size: initial;

		/* With a note after. */
		/* TODO Use `sub` for this? Adjusting Markdown. */
		&:has(br) {
			/* TODO Bobble with/without this—type inset? */
			--size: var(--size--note);

			em { line-height: 1 } /* Helps with `em` and rounding? */

			> a:has(> cite) { margin-block-end: calc(var(---4px)) }

			/* TODO Unravel this! Shouldn’t need the override. */
			@supports (not (font: -apple-system-body)) and (not (-moz-appearance: none)) { --font: 'Geneva 9' }
		}

		> a:has(> cite) {
			--size: var(--size--root);

			inline-size:         fit-content;
			isolation:           isolate;
			margin-inline-end:   var(--right);
			margin-inline-start: var(--left);

			:where(cite) {
				--padding: 1ex;

				box-shadow:           var(--shadow--border), var(--shadow--single);
				display:              block;
				inline-size:          fit-content;
				margin-inline:        initial;
				padding-block:        var(--padding);
				padding-inline-end:   calc(var(--padding) - var(--right));
				padding-inline-start: calc(var(--padding) - var(--left));
				position:             relative;
				z-index:              1; /* In front of the link enlargement. */
			}
		}
	}
</style>
<cite webc:root="override"><slot></slot></cite>
