<style>
	:where(p, li):has(a > cite):not(:has(ul)) {
		--wrap: balance;

		inline-size: fit-content; /* Cinch (for `:hover`). */
		max-inline-size: initial;

		/* With a note after. */
		&:has(br) {
			--size: var(--size--note);

			line-height: round(1cap, var(--1px));

			* { line-height: 1 } /* Helps with `em` and rounding? */

			> a:has(> cite) { margin-block-end: var(--shim) }

			/* TODO Unravel this! Shouldn’t need the override. */
			@supports (not (font: -apple-system-body)) and (not (-moz-appearance: none)) { --font: 'Geneva 9' }
		}

		> a:has(> cite) {
			--size: var(--size--root);

			inline-size:         fit-content;
			margin-inline-end:   var(--right);
			margin-inline-start: var(--left);

			cite {
				--padding: calc(round(1rex, var(--1px)) - var(--1px));

				border:               var(--border);
				box-shadow:           var(--shadow--single);
				display:              block;
				inline-size:          fit-content;
				margin-inline:        initial;
				padding-block:        var(--padding);
				padding-inline-end:   calc(var(--padding) - var(--right));
				padding-inline-start: calc(var(--padding) - var(--left));
				position:             relative;
				z-index:              1; /* In front of the link enlargement. */
			}

			[inert] & {
				border:              var(--1px) solid transparent;
				border-image-slice:  2;
				border-image-source: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='8' height='8'><rect x='0' y='0' width='4' height='2'/><rect x='6' y='0' width='2' height='2'/><rect x='0' y='6' width='4' height='2'/><rect x='6' y='6' width='2' height='2'/><rect x='0' y='2' width='2' height='2'/><rect x='6' y='2' width='2' height='2'/></svg>");
				border-image-repeat: round;

				cite {
					box-shadow: initial;
					border:     initial;
				}
			}

		}
	}
</style>
<cite webc:root="override"><slot></slot></cite>
