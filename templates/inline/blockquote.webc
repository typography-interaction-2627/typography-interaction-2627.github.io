<style>
	blockquote {
		--family: 'New York';
		--size:   var(--size--h3); /* Deviate for mobile wraps. */

		display:       grid;
		grid-column:   all;
		justify-items: center;
		row-gap:       inherit;
		text-align:    center;

		@container style(--columns) {
			--size:   var(--size--h2);

			margin-inline: var(--gutter);
		}

		&:where(:not(:first-child)),
		&:where(:not(:last-child)) + * {
			margin-block-start: 2rlh;

			@container style(--columns) { margin-block-start: 3rlh }
		}

		hgroup:has(h2) + & {
			margin-block-start: 1rlh;

			@container style(--columns) { margin-block-start: 2rlh }
		}

		/* Go big. */
		@media (width >= 86em) { &:not(:has(> p:nth-of-type(4))) { --size: var(--size--h1) } }

		p:has(a > cite) {
			--family: 'Geneva';
			--size:   var(--size--root);

			margin-block-start: 1rlh;
		}

		/* That damn Håkon quote. */
		pre {
			background:     linear-gradient(var(--background)) padding-box, var(--background--check) border-box;
			border:         var(--1px) solid transparent;
			clip-path:      var(--clip--corner);
			letter-spacing: initial;
			text-align:     left;

			code { color: var(--color) }

			&::before, &::after { background-color: var(--background) }
		}
	}
</style>
<blockquote webc:root="override">
	<slot></slot>
</blockquote>
