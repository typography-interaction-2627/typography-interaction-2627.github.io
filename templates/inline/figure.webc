<style>
	figure {
		--gap: 1rlh;

		align-items:  start;
		anchor-scope: --figure-container;
		display:      grid;
		position:     relative;
		row-gap:      var(--gap);

		/* Default full-width. */
		&:not([class]), &[class="borderless"] { grid-column: all }

		&:where(:not(:first-child)),
		&:where(:not(:last-child)) + :where(*:not(section)) {
			margin-block-start: 1rlh;

			@container style(--columns) { margin-block-start: 3rlh }
		}

		hgroup + & {
			@container style(--columns) { margin-block-start: 2rlh }
		}

		/* Anchor/example links. */
		> :where(a, menu) {
			inset-block-end:  anchor(start);
			inset-inline-end: anchor(end);
			margin-block-end: calc(var(--gap) / 2);
			position-anchor:  --figure-container;
			position:         absolute;
		}

		> menu {
			display: flex;
			gap:     var(--gap);

			> li { display: flex }
		}

		> a,
		> menu a {
			--family:  'Geneva';
			--size:    14;

			block-size:       var(--7px);
			display:          inline-block;
			inline-size:      var(--7px);
			opacity:          var(--opacity);
			text-box:         trim-both cap alphabetic;
			transition-delay: var(--delay, 1s); /* “Coyote time.” */

			/* `opsz` dance. */
			@supports (not (-moz-appearance: none)) { --font: 'Geneva 14' }

			span { display: inline-block }

			&[href^='#'] span { translate: var(---1px) var(---1px) }

			&[href$='/preview'] {
				inline-size: calc(11 * var(--1px));

				span { translate: var(---1px) var(---2px) }
			}

			&:not([href^='#']):not([href$='/preview']) {
				background-image:    url('/assets/icons/&nearr.svg');
				background-position: bottom left;
				background-repeat:   no-repeat;
				background-size:     var(--7px);

				span { color: transparent } /* Hide actual arrow. */
			}
		}

		/* Toggle anchor/example links. */
		@media (any-hover: hover) {
			> :where(a, menu) { --opacity: 0 }

			> a:focus:focus-visible,
			> menu:has(a:focus:focus-visible),
			&:has(div:hover) > :where(a, menu) {
				--opacity: 1;
				--delay:   0;
			}
		}

		/* Container for placing the dithered one/effects. */
		> div {
			anchor-name: --figure-container;
			position:    relative;

			&:has(img) {
				inline-size: fit-content;

				@supports (inline-size: calc-size(fit-content, size)) {
					block-size:  calc-size(fit-content, round(size, var(--1px)));
					inline-size: calc-size(fit-content, round(size, var(--1px)));
				}
			}

			/* TODO How to have this always snap to pixel height? Takes “windows” off-pattern! */
			img, iframe {
				--height--lines: calc((var(--lines)) * 1rlh + 1rcap + var(--4px));
				--height--max:   calc(0.75 * var(--svh));

				filter:          saturate(var(--in-view)) contrast(calc(2 - var(--in-view))) brightness(calc(2 - var(--in-view)));
				max-inline-size: 100%;

				/* TODO Abstract this pattern! */
				@supports (animation-timeline: view()) {
					animation-fill-mode:       both;
					animation-name:            in-view;
					animation-range:           cover;
					animation-timeline:        view();
					animation-timing-function: ease-in-out;
				}
			}

			img {
				block-size:     calc(var(--height) / var(--zoom, 1));
				max-block-size: round(calc(min(var(--height--max), var(--height--lines, var(--height--max))) / var(--zoom, 1)), var(--1px));
				zoom:           var(--zoom); /* So they aren’t as limited by intrinsic resolution. */

				@container style(--scaling: 3) { --zoom: 1.5 }
			}

			iframe {
				aspect-ratio: var(--aspect-ratio, 16/9);
				inline-size:  100%;

				/* Code previews. */
				&:not([src*="https://"])[src*='/preview'] {
					block-size:     var(--height--lines);
					max-block-size: calc(round(var(--height--max), 1rlh) + 1rcap + var(--4px));

					@media (width < 35em) {
						aspect-ratio:   1 / 2;
						block-size:     initial;
						max-block-size: round(var(--height--max), 1rcap);
					}
				}
			}

			&:has(iframe:not([src*="https://"])[src*='/preview']) {
				background-color: var(--background);
				isolation:        isolate;

				iframe { z-index: 1 }

				&::after {
					background:     var(--background--check);
					box-shadow:     initial;
					content:        '';
					inset:          0;
					mix-blend-mode: multiply;
					position:       absolute;
					translate:      var(--2px) var(--2px);
				}
			}

			/* Web component that does the Atkinson dithering! */
			as-dithered-image {
				inset:    0;
				opacity:  calc(1 - var(--in-view));
				position: absolute;

				@supports (animation-timeline: view()) {
					animation-fill-mode:       both;
					animation-name:            in-view;
					animation-range:           cover;
					animation-timeline:        view();
					animation-timing-function: ease-in-out;
				}
			}

			&:hover {
				--in-view: 1;

				img, iframe, as-dithered-image { animation-name: none }
			}
		}

		/* A “border” around these. */
		&:not(.borderless) div:has(img, iframe) {
			background-color: var(--color);

			&::after {
				box-shadow:     var(--shadow--border);
				content:        '';
				inset:          0;
				position:       absolute;
				pointer-events: none;
			}
		}

		/* Looser space. */
		&.borderless { --gap: calc(2rlh - 1rcap) }

		figcaption {
			--size: var(--size--note);
			--wrap: balance;

			p { max-inline-size: 72ch }

			&:has(a > cite) {
				--icon: calc(var(--1px) * 12);

				position:             relative;
				padding-inline-start: calc(var(--icon) + 1rlh);
			}

			a:has(cite) {
				inset-block-start:  var(---4px);
				inset-inline-start: 0;
				position:           absolute;

				cite {
					background-image:    url('/assets/icons/&nearr.svg');
					background-position: center;
					background-repeat:   no-repeat;
					background-size:     var(--7px);
					block-size:          var(--7px);
					color:               transparent; /* Hide the actual text. */
					display:             block;
					inline-size:         var(--7px);
					padding:             var(--padding);
				}
			}
		}
	}
</style>
<script type="module">
	// Match the dithering “pixel” to our scaled pixel.
	let frame

	const setCrunch = () => {
		const style = getComputedStyle(document.documentElement)
		const scaling = style.getPropertyValue('--scaling')

		document.querySelectorAll(`as-dithered-image:not([crunch="${scaling}"])`).forEach((dither) => dither.setAttribute('crunch', scaling))
	}

	setCrunch()
	addEventListener('resize', () => (cancelAnimationFrame(frame), frame = requestAnimationFrame(setCrunch)))
</script>
<figure webc:root="override">
	<slot></slot>
</figure>
