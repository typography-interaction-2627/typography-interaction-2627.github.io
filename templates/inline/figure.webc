<style>
	@keyframes dither-visibility {
		0%   { --opacity: 1 }
		33%  { --opacity: 1 }
		40%  { --opacity: 0 }
		60%  { --opacity: 0 }
		66%  { --opacity: 1 }
		100% { --opacity: 1 }
	}

	figure {
		align-items: start;
		display:     grid;
		position:    relative;
		row-gap:     round(1rlh, var(--1px));

		&:not([class]) { grid-column: all }

		&:where(:not(:first-child)),
		&:where(:not(:last-child)) + * {
			margin-block-start: round(1rlh, var(--1px));

			@container style(--columns: 6) { margin-block-start: round(3rlh, var(--1px)) }
		}

		/* Container for placing the dithered one. */
		div {
			inline-size: fit-content;
			position:    relative;

			img {
				--height--fallback: round(calc(var(--lines) * 1rlh - 1rcap), var(--1px));

				block-size:      var(--height, var(--height--fallback));
				max-block-size:  calc(round(80svh, 1rcap));
				max-inline-size: 100%;
			}

			/* Web component that does the Atkinson dithering! */
			as-dithered-image {
				--opacity: 0;

				inset:      0;
				opacity:    var(--opacity);
				position:   absolute;

				@supports (animation-timeline: view()) {
					animation-name:            dither-visibility;
					animation-timing-function: ease-in-out;
					animation-fill-mode:       both;
					animation-timeline:        view();
					animation-range:           cover;
				}

				@media (any-hover: hover) {
					--opacity: 1;

					&:hover {
						--opacity: 0;
					}
				}
			}
		}

		figcaption {
			--size: var(--size--note);
			--wrap: balance;

			p { max-inline-size: 72ch }

			&:has(a > cite) {
				--icon: calc(var(--1px) * 12);

				position:             relative;
				padding-inline-start: calc(var(--icon) + round(1rlh, var(--1px)));
			}

			a:has(cite) {
				/* TODO This is off on mobile! */
				inset-block-start:  calc(-1 * var(--3px) - var(--shim));
				inset-inline-start: 0;
				position:           absolute;

				cite {
					aspect-ratio:        1;
					background-image:    url('/assets/icons/arrow.svg');
					background-position: center;
					background-repeat:   no-repeat;
					background-size:     var(--7px);
					font-size:           0; /* Hide the `↗` */
				}
			}
		}
	}
</style>
<script webc:keep src="/assets/scripts/as-dithered-image/as-dithered-image.js"></script>
<script type="module">
	document.querySelectorAll('figure').forEach((figure) => {
		const image = figure.querySelector('img[src]')
		const wrapper = figure.querySelector('div')
		const dithered = wrapper.querySelector('as-dithered-image')

		if (!image) return wrapper.remove()

		wrapper.prepend(image)
		dithered.setAttribute('src', image.src)
	})
</script>
<figure webc:root="override">
	<div>
		<as-dithered-image crunch="2"></as-dithered-image>
	</div>
	<slot></slot>
</figure>
