<style>
	@keyframes dither-visibility {
		0%   { --opacity: 1 }
		33%  { --opacity: 1 }
		40%  { --opacity: 0 }
		60%  { --opacity: 0 }
		66%  { --opacity: 1 }
		100% { --opacity: 1 }
	}

	figure {
		align-items: start;
		display:     grid;
		position:    relative;
		row-gap:     round(1rlh, var(--1px));

		&:not([class]) { grid-column: all }

		&:where(:not(:first-child)),
		&:where(:not(:last-child)) + * {
			margin-block-start: round(1rlh, var(--1px));

			@container style(--columns: 6) { margin-block-start: round(3rlh, var(--1px)) }
		}

		/* Container for placing the dithered one. */
		div {
			inline-size: fit-content;
			position:    relative;

			img {
				--height--fallback: round(calc(var(--lines) * 1rlh - 1rcap), var(--1px));

				block-size:      var(--height, var(--height--fallback));
				max-block-size:  calc(round(80svh, 1rcap));
				max-inline-size: 100%;
			}

			/* Web component that does the Atkinson dithering! */
			as-dithered-image {
				--opacity: 0;

				inset:    0;
				opacity:  var(--opacity);
				position: absolute;

				@supports (animation-timeline: view()) {
					--opacity: 1;

					animation-fill-mode: both;
					animation-name: dither-visibility;
					animation-range: cover;
					animation-timeline: view();
					animation-timing-function: ease-in-out;
				}

				/* TODO `:hover` override! */
			}
		}

		figcaption {
			--size: var(--size--note);
			--wrap: balance;

			p { max-inline-size: 72ch }

			&:has(a > cite) {
				--icon: calc(var(--1px) * 12);

				position:             relative;
				padding-inline-start: calc(var(--icon) + round(1rlh, var(--1px)));
			}

			a:has(cite) {
				/* TODO This is off on mobile! */
				inset-block-start:  calc(-1 * var(--3px) - var(--shim));
				inset-inline-start: 0;
				position:           absolute;

				/* TODO The size for this is wonky in Safari! */
				cite {
					aspect-ratio:        1;
					background-image:    url('/assets/icons/arrow.svg');
					background-position: center;
					background-repeat:   no-repeat;
					background-size:     var(--7px);
					font-size:           0; /* Hide the `↗` */
				}
			}
		}
	}
</style>
<script type="module">
	document.querySelectorAll('figure').forEach((figure) => {
		const images = figure.querySelectorAll('img[src]')
		const template = figure.querySelector('div')

		if (!images.length) return template.remove()

		let previous = template

		images.forEach((image, i) => {
			// Always clone from the untouched template so prior images aren't carried along.
			const div = template.cloneNode(true)

			i ? previous.after(div) : template.replaceWith(div)

			div.prepend(image)
			div.querySelector('as-dithered-image').setAttribute('src', image.src)
			previous = div
		})
	})

	// TODO Need a `crunch="3"` based on scaling variable!
</script>
<figure webc:root="override">
	<div>
		<as-dithered-image crunch="2"></as-dithered-image>
	</div>
	<slot></slot>
</figure>
