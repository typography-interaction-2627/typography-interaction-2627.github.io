<style>
	figure {
		align-items: start;
		display:     grid;
		position:    relative;
		row-gap:     1rlh;

		/* Default full-width. */
		&:not([class]), &[class="borderless"] { grid-column: all }

		&:where(:not(:first-child)),
		&:where(:not(:last-child)) + * {
			margin-block-start: 1rlh;

			@container style(--columns) { margin-block-start: 3rlh }
		}

		hgroup + & {
			@container style(--columns) { margin-block-start: 2rlh }
		}

		/* Container for placing the dithered one/effects. */
		> div {
			position: relative;

			&:has(img) {
				inline-size: fit-content;

				@supports (inline-size: calc-size(fit-content, size)) {
					block-size:  calc-size(fit-content, round(size, var(--1px)));
					inline-size: calc-size(fit-content, round(size, var(--1px)));
				}
			}

			/* TODO How to have this always snap to pixel height? Takes “windows” off-pattern! */
			/* TODO Stretches on mobile! See *Typography*. */
			img, iframe {
				--height--fallback: calc((var(--lines)) * 1rlh + 1rcap + var(--4px));

				block-size:      var(--height, var(--height--fallback));
				filter:          saturate(var(--in-view)) contrast(calc(2 - var(--in-view))) brightness(calc(2 - var(--in-view)));
				max-block-size:  calc(round(80svh, var(--1px)));
				max-inline-size: 100%;

				/* TODO Abstract this pattern! */
				@supports (animation-timeline: view()) {
					animation-fill-mode:       both;
					animation-name:            in-view;
					animation-range:           cover;
					animation-timeline:        view();
					animation-timing-function: ease-in-out;
				}
			}

			iframe {
				aspect-ratio: var(--aspect-ratio, 16/9);
				inline-size:  100%;

				/* Code previews. */
				&:not([src*="https://"])[src*='/preview'] {
					inline-size: 100%;

					@media (width < 35em) {
						aspect-ratio:   1 / 2;
						block-size:     initial;
						max-block-size: calc(round(75svh, 1rcap));
					}
				}
			}

			/* Web component that does the Atkinson dithering! */
			as-dithered-image {
				inset:    0;
				opacity:  calc(1 - var(--in-view));
				position: absolute;

				@supports (animation-timeline: view()) {
					animation-fill-mode:       both;
					animation-name:            in-view;
					animation-range:           cover;
					animation-timeline:        view();
					animation-timing-function: ease-in-out;
				}
			}

			&:hover {
				--in-view: 1;

				img, iframe, as-dithered-image { animation-name: none }
			}
		}

		/* A “border” around these. */
		&:not(.borderless) div:has(img, iframe) {
			background-color: var(--color);

			&::after {
				box-shadow:     var(--shadow--border);
				content:        '';
				inset:          0;
				position:       absolute;
				pointer-events: none;
			}
		}

		/* Looser space. */
		&.borderless { row-gap: calc(2rlh - 1rcap) }

		figcaption {
			--size: var(--size--note);
			--wrap: balance;

			p { max-inline-size: 72ch }

			&:has(a > cite) {
				--icon: calc(var(--1px) * 12);

				position:             relative;
				padding-inline-start: calc(var(--icon) + 1rlh);
			}

			a:has(cite) {
				inset-block-start:  var(---4px);
				inset-inline-start: 0;
				position:           absolute;

				cite {
					background-image:    url('/assets/icons/&nearr.svg');
					background-position: center;
					background-repeat:   no-repeat;
					background-size:     var(--7px);
					block-size:          var(--7px);
					color:               transparent; /* Hide the actual text. */
					display:             block;
					inline-size:         var(--7px);
					padding:             var(--padding);
				}
			}
		}
	}
</style>
<script type="module">
	// Match the dithering “pixel” to our scaled pixel.
	let frame

	const setCrunch = () => {
		const crunch = getComputedStyle(document.documentElement).getPropertyValue('--scaling').trim() || '2'

		document.querySelectorAll(`as-dithered-image:not([crunch="${crunch}"])`).forEach((dither) => dither.setAttribute('crunch', crunch))
	}

	setCrunch()
	addEventListener('resize', () => (cancelAnimationFrame(frame), frame = requestAnimationFrame(setCrunch)))
</script>
<figure webc:root="override">
	<slot></slot>
</figure>
