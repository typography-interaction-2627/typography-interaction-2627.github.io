<style>
	@keyframes in-view {
		0%   { --in-view: 0 }
		33%  { --in-view: 0 }
		40%  { --in-view: 1 }
		60%  { --in-view: 1 }
		66%  { --in-view: 0 }
		100% { --in-view: 0 }
	}

	figure {
		align-items: start;
		display:     grid;
		position:    relative;
		row-gap:     1rlh;

		/* Default full-width. */
		&:not([class]), &[class="borderless"] { grid-column: all }

		&:where(:not(:first-child)),
		&:where(:not(:last-child)) + * {
			margin-block-start: 1rlh;

			@container style(--columns) { margin-block-start: 3rlh }
		}

		hgroup + & {
			@container style(--columns) { margin-block-start: 2rlh }
		}

		/* Before they are wrapped by JS. */
		> :where(img, object) { inline-size: fit-content }
		> :where(iframe) { inline-size: 100% }

		/* Container for placing the dithered one. */
		div {
			position: relative;

			&:has(img, object) {
				inline-size: fit-content;

				@supports (inline-size: calc-size(fit-content, size)) {
					inline-size: calc-size(fit-content, round(size, var(--1px)));
				}
			}


			/* TODO How to have this always snap to pixel height? Takes “windows” off-pattern! */
			img,
			object,
			iframe {
				--height--fallback: calc(var(--lines) * 1rlh - 1rcap);

				block-size:      var(--height, var(--height--fallback));
				filter:          saturate(var(--in-view));
				max-block-size:  calc(round(80svh, var(--1px)));
				max-inline-size: 100%;

				@supports (animation-timeline: view()) {
					animation-fill-mode:       both;
					animation-name:            in-view;
					animation-range:           cover;
					animation-timeline:        view();
					animation-timing-function: ease-in-out;
				}
			}

			iframe {
				aspect-ratio: var(--aspect-ratio, 16/9);
				inline-size:  100%;
			}

			/* Web component that does the Atkinson dithering! */
			as-dithered-image {
				inset:    0;
				opacity:  calc(1 - var(--in-view));
				position: absolute;

				@supports (animation-timeline: view()) {
					animation-fill-mode:       both;
					animation-name:            in-view;
					animation-range:           cover;
					animation-timeline:        view();
					animation-timing-function: ease-in-out;
				}
			}

			&:hover {
				--in-view: 1;

				img, object, iframe, as-dithered-image { animation-name: none }
			}
		}

		/* A “border” around these. */
		&:not(.borderless) div:has(img, object, iframe) {
			background-color: var(--color);

			&::after {
				box-shadow:     var(--shadow--border);
				content:        '';
				inset:          0;
				position:       absolute;
				pointer-events: none;
			}
		}

		/* Looser space. */
		&.borderless { row-gap: calc(2rlh - 1rcap) }

		figcaption {
			--size: var(--size--note);
			--wrap: balance;

			p { max-inline-size: 72ch }

			&:has(a > cite) {
				--icon: calc(var(--1px) * 12);

				position:             relative;
				padding-inline-start: calc(var(--icon) + 1rlh);
			}

			a:has(cite) {
				inset-block-start:  var(---4px);
				inset-inline-start: 0;
				position:           absolute;

				cite {
					background-image:    url('/assets/icons/&nearr.svg');
					background-position: center;
					background-repeat:   no-repeat;
					background-size:     var(--7px);
					block-size:          var(--7px);
					color:               transparent; /* Hide the actual text. */
					display:             block;
					inline-size:         var(--7px);
					padding:             var(--padding);
				}
			}
		}
	}
</style>
<script type="module">
	document.querySelectorAll('figure').forEach((figure) => {
		const media = figure.querySelectorAll('img[src], :scope > iframe')
		const template = figure.querySelector('div')

		if (!media.length) return template.remove()

		const pristine = template.cloneNode(true) // Clone from this so prior media aren't carried along.

		let previous

		media.forEach((element) => {
			const div = previous ? pristine.cloneNode(true) : template
			const dither = div.querySelector('as-dithered-image')

			previous?.after(div)
			div.prepend(element)
			element.localName === 'img' ? dither.setAttribute('src', element.src) : dither.remove()
			previous = div
		})
	})

	// Match the dithering “pixel” to our scaled pixel.
	let frame

	const setCrunch = () => {
		const crunch = getComputedStyle(document.documentElement).getPropertyValue('--scaling').trim() || '2'

		document.querySelectorAll(`as-dithered-image:not([crunch="${crunch}"])`).forEach((dither) => dither.setAttribute('crunch', crunch))
	}

	setCrunch()
	addEventListener('resize', () => (cancelAnimationFrame(frame), frame = requestAnimationFrame(setCrunch)))
</script>
<figure webc:root="override">
	<div>
		<as-dithered-image crunch="2"></as-dithered-image>
	</div>
	<slot></slot>
</figure>
