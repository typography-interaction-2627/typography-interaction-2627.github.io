<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta content="initial-scale=1, width=device-width, viewport-fit=cover" name="viewport">
		<title @html="stripTags(title)"></title>
		<template webc:if="!buildawesomeExcludeFromCollections" webc:nokeep>
			<!-- TODO Generate /preview metadata? -->
			<link :href="`${pkg.homepage}${$data.page.url}`" rel="canonical">
			<link href="#license" rel="license">
			<meta :content="description || ''" name="description">
			<meta :content="`${pkg.homepage}${$data.page.url}meta.png`" property="og:image">
			<script webc:keep src="/assets/scripts/as-dithered-image/as-dithered-image.js"></script>
		</template>
		<meta webc:else content="noindex, nofollow" name="robots">
		<link :href="`/assets/${sequence ? 'patterns/' + sequence : 'icons/tab'}.svg`" rel="icon" type="image/svg+xml">
		<link href="/assets/icons/touch.png" rel="apple-touch-icon">
		<style webc:is="style-buckets" webc:nokeep>/* Can’t use custom element in the `head`! */</style>
		<script webc:keep src="/assets/ti-preview/index.js" type="module"></script>
		<script webc:keep @raw="getBundle('js')" type="module"></script>
	</head>
	<body @raw="content"></body>
</html>
