<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta
			content="initial-scale=1, width=device-width, viewport-fit=cover"
			name="viewport"
		>
		<title @html="title"></title>
	</head>
	<body>
		<h1 @html="title"></h1>
		<template
			webc:nokeep
			@raw="content"
		></template>
		<h2>Sessions</h2>
		<ul>
			<li webc:for="item of $data.collections.weeks">
				<a :href="item.url">
					<p @html="item.data.title"></p>
				</a>
				<p @text="displayDate(item.data.date)"></p>
			</li>
		</ul>
		<h2>Projects</h2>
		<ul>
			<li webc:for="item of $data.collections.projects">
				<a :href="item.url">
					<p @html="item.data.title"></p>
					<p @text="displayDate(item.data.date)"></p>
				</a>
			</li>
		</ul>
		<h2>Topics</h2>
		<ul>
			<li webc:for="item of $data.collections.topics">
				<a :href="item.url">
					<p @html="item.data.title"></p>
				</a>
			</li>
		</ul>
	</body>
</html>
