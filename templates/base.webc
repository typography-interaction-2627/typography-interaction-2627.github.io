<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta content="initial-scale=1, width=device-width, viewport-fit=cover" name="viewport">
		<title @html="stripTags(title)"></title>
		<script webc:setup>
			// TODO I think we can move this to data? For less parseHtml use!
			export const getDescription = ({ content, description }) => {
				const document = parseHtml(content)

				const descriptions = document.querySelectorAll('main [data-description]')

				const descriptionHtml = description
					? description
					: descriptions.length
						? [...descriptions].map((node) => node.innerHTML).join(' ')
						: document.querySelector('main p')?.innerHTML || ''

				return stripTags(descriptionHtml)
					.trim()
					.replace(/\s+/g, ' ') // Collapse white space.
					.replace(/:$/, '.') // Fix ending colons.
					.replace(/&amp;/g, '\u0026') // Decode entity so BA doesn’t `&amp;` it twice.
					.replace(/&nbsp;/g, '\u00A0') // Same.
			}

			export const removeDescriptionAttr = (content, document = parseHtml(content)) =>
				(document.querySelectorAll('[data-description]').forEach(n => n.removeAttribute('data-description')), document.toString())
		</script>
		<template webc:if="!buildawesomeExcludeFromCollections" webc:nokeep>
			<!-- TODO Generate /preview metadata? -->
			<link href="#license" rel="license">
			<meta :content="getDescription($data)" name="description">
			<meta :content="`https://typography-interaction-2627.github.io${$data.page.url}meta.png`" property="og:image">
			<script webc:keep src="/assets/scripts/as-dithered-image/as-dithered-image.js"></script>
		</template>
		<meta webc:else content="noindex, nofollow" name="robots">
		<link :href="`/assets/${sequence ? 'patterns/' + sequence : 'icons/tab'}.svg`" rel="icon" type="image/svg+xml">
		<link href="/assets/icons/touch.png"  rel="apple-touch-icon">
		<style webc:is="style-buckets" webc:nokeep>/* Can’t use custom element in the `head`! */</style>
		<script webc:keep @raw="getBundle('js')" type="module"></script>
	</head>
	<body @raw="removeDescriptionAttr(content)"></body>
</html>
