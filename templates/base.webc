<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta content="initial-scale=1, width=device-width, viewport-fit=cover" name="viewport">
		<title @text="stripTags(title)"></title>
		<script webc:setup>
			export const getDescription = ({ content, description }) => {
				const document = parseHtml(content)

				const descriptions = document.querySelectorAll('main [data-description]')

				const descriptionHtml = description
					? description
					: descriptions.length
						? [...descriptions].map((node) => node.innerHTML).join(' ')
						: document.querySelector('main p')?.innerHTML || ''

				return stripTags(descriptionHtml)
					.trim()
					.replace(/\s+/g, ' ') // Collapse white space.
					.replace(/:$/, '.') // Fix ending colons.
					.replace(/&amp;/g, '\u0026') // Decode entity so BA doesn’t `&amp;` it twice.
					.replace(/&nbsp;/g, '\u00A0') // Same.
			}
		</script>
		<template webc:if="!buildawesomeExcludeFromCollections" webc:nokeep>
			<meta :content="getDescription($data)" name="description">
		</template>
		<meta webc:else content="noindex, nofollow" name="robots">
	</head>
	<body>
		<template
			webc:nokeep
			@raw="content"
		></template>
	</body>
</html>
