<script webc:setup>
	export const getChannels = (data) => {
		const channels = parseHtml(data.collections.root.find(({ inputPath }) => inputPath.endsWith('content/syllabus.md')).content).querySelector('#channels')
		channels?.firstElementChild?.remove()

		channels?.querySelectorAll('li').forEach((item) => {
			const link = item.querySelector('a')
			const cite = link?.querySelector('cite')

			cite && (
				link.set_content(`<p><strong>${cite.innerHTML}</strong></p>`),
				item.set_content(link.outerHTML)
			)
		})

		return channels?.innerHTML ?? ''
	}
</script>
<style>
	@position-try --in-page {
		inset-inline-end:   var(--inline);
		inset-inline-start: initial;
		position-area: none;
	}

	details[name='nav'] {
		anchor-scope: --nav-details;

		summary {
			anchor-name: --nav-details;

			/* Drop arrow. */
			svg:last-child:not(:only-of-type) {
				block-size: var(--3px);
				rotate:     var(--rotate);
			}
		}

		&[open] { --rotate: 180deg }

		&::details-content {
			inset-block-start:  anchor(end);
			inset-inline-start: anchor(start);
			position-anchor:    --nav-details;
			position-try:       flip-inline, --in-page;
			position:           fixed;
		}

		ul {
			/* Space under the `nav`, less gutters. */
			--remainder: calc(100dvh - var(--block) - (2 * var(--padding) + 9 * var(--1px)) - 2 * var(--gutter));

			background-color: var(--background);
			max-block-size:   var(--remainder);
			overflow-y:       scroll;

			li {
				padding-block:  1ex;
				padding-inline: 1cap;

				a {
					display: grid;
					gap:     1ex;

					p:has(sub) { --size: var(--size--note) }
				}
			}
		}
	}
</style>
<details name="nav" webc:root="override">
	<summary :aria-label="initialCap(collection)" webc:keep webc:root="override">
		<svg webc:nokeep @html="inlineSvg(`assets/icons/nav/${collection?.replace(/s$/, '') || 'channels'}.svg`)"></svg>
		<p webc:if="collection" @text="initialCap(collection?.replace(/s$/, ''))"></p>
		<svg webc:nokeep @html="inlineSvg('assets/icons/nav/drop.svg')"></svg>
	</summary>
	<ul webc:if="collection">
		<li webc:for="item of $data.collections[collection]">
			<a :href="item.url">
				<p><strong @html="item.data.title"></strong></p>
				<p webc:if="collection != 'topics'"><sub @text="displayDate(item.data.date)"></sub></p>
			</a>
		</li>
	</ul>
	<ul webc:else @raw="getChannels($data)"></ul>
</details>
