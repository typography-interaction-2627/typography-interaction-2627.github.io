<script webc:setup>
	export const getChannels = (data) => {
		const channels = parseHtml(data.collections.root.find(({ inputPath }) => inputPath.endsWith('content/syllabus.md')).content).querySelector('#channels')
		channels?.firstElementChild?.remove()

		channels?.querySelectorAll('li').forEach((item) => {
			const link = item.querySelector('a')
			const cite = link?.querySelector('cite')

			cite && (
				link.set_content(`<p>${cite.innerHTML}</p>`),
				item.set_content(link.outerHTML)
			)
		})

		return channels?.innerHTML ?? ''
	}
</script>
<style>
	@position-try --in-page {
		inset-inline-end:   var(--edge);
		inset-inline-start: initial;
	}

	details[name='nav'] {
		anchor-scope: --nav-details;

		summary {
			anchor-name: --nav-details;
			user-select: none;

			/* Drop arrow. */
			svg:last-child:not(:only-of-type) {
				block-size: var(--3px);
				rotate:     var(--rotate);
			}
		}

		&[open] {
			--rotate: 180deg;

			/* TODO Propery variable dance for theses! */
			summary {
				background-color: var(--background);
				box-shadow:       var(--shadow--border--upper), var(--shadow--single);

				* { --color: initial }

				&::before {
					background-color: var(--background);
					block-size:       var(--1px);
					content:          '';
					inset-block-end:  var(---1px);
					inset-inline:     var(--1px);
					mask:             var(--background--check);
					position:         absolute;
					z-index:          1;
				}
			}

			ul { box-shadow: var(--shadow--border), var(--shadow--single) }
		}

		&::details-content {
			inset-block-start:  anchor(end);
			inset-inline-start: anchor(start);
			position-anchor:    --nav-details;
			position-try:       flip-inline, --in-page;
			position:           fixed;
		}

		ul {
			/* Space under the `nav`, less gutters. */
			--remainder: calc(100dvh - var(--block) - (2 * var(--padding) + 9 * var(--1px)) - 2 * var(--gutter));

			background-color: var(--background);
			display:          grid;
			inline-size:      max-content;
			justify-items:    start;
			max-block-size:   round(var(--remainder), var(--1px));
			max-inline-size:  round(80vw, var(--1px));
			overflow-y:       scroll;
			padding-block:    2ex;
			padding-inline:   2ex;
			row-gap:          2ex;
			scrollbar-width:  none;

			li {
				a {
					display: grid;
					gap:     1ex;

					p {
						margin-block:  var(---3px);
						overflow:      hidden;
						padding-block: var(--3px);
						text-overflow: ellipsis;

						&:has(sub) {
							--family: 'Geneva';
							--size: var(--size--note);

							sub { display: block }
						}
					}
				}

				/* Drafts. */
				&:has(a:not([href])) {
					margin:         var(---3px);
					mask:           var(--background--check);
					padding:        var(--3px);
					pointer-events: none;
					user-select:    none;
				}
			}
		}
	}
</style>
<script webc:bucket="default">
	document.addEventListener('click', event =>
		document.querySelectorAll('nav details[open]').forEach(detail =>
			!detail.contains(event.target) && detail.removeAttribute('open')))

	document.addEventListener('keydown', event =>
		event.key === 'Escape' && document.querySelector('nav details[open]')?.removeAttribute('open'))
</script>
<details name="nav" webc:root="override">
	<summary :aria-label="initialCap(collection)" webc:keep webc:root="override">
		<svg webc:nokeep @html="inlineSvg(`assets/icons/nav/${collection?.replace(/s$/, '') || 'channels'}.svg`)"></svg>
		<svg webc:nokeep @html="inlineSvg('assets/icons/nav/drop.svg')"></svg>
	</summary>
	<ul webc:if="collection">
		<li webc:for="item, index of $data.collections[collection]">
			<a :href="item.url">
				<p @html="item.data.title"></p>
				<p webc:if="item.url && collection != 'topics' && index === $data.collections[collection].findLastIndex(item => item.url)"><sub @text="displayDate(item.data.date)"></sub></p>
			</a>
		</li>
	</ul>
	<ul webc:else @raw="getChannels($data)"></ul>
</details>
