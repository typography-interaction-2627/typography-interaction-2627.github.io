<script webc:setup>
	export const getChannels = (data) => {
		const channels = parseHtml(data.collections.root.find(({ inputPath }) => inputPath.endsWith('content/syllabus.md')).content).querySelector('#channels')
		channels?.firstElementChild?.remove()

		channels?.querySelectorAll('li').forEach((item) => {
			const link = item.querySelector('a')
			const cite = link?.querySelector('cite')

			cite && (
				link.set_content(`<p>${cite.innerHTML}</p>`),
				item.set_content(link.outerHTML)
			)
		})

		return channels?.innerHTML ?? ''
	}
</script>
<style>
	@position-try --in-page {
		inset-inline-end:   var(--inline);
		inset-inline-start: initial;
	}

	details[name='nav'] {
		pointer-events: auto;
		anchor-scope:   --nav-details;

		summary {
			anchor-name: --nav-details;
			user-select: none;
			z-index:     1;

			/* Drop arrow. */
			svg:last-child:not(:only-of-type) {
				block-size: var(--3px);
				rotate:     var(--arrow, 0deg);
			}
		}

		&[open] {
			--arrow: 180deg;

			/* TODO Propery variable dance for theses! */
			summary {
				background-color: var(--background);
				box-shadow:       var(--shadow--border--upper), var(--shadow--single);

				* { --color: initial }

				&::before {
					background-color: var(--background);
					block-size:       var(--1px);
					content:          '';
					inset-block:      var(--divider, auto var(---1px));
					inset-inline:     var(--1px);
					mask:             var(--background--check);
					position:         absolute;
					z-index:          1;

					/* Start pattern on white. */
					mask-position: var(--2px) 0;
				}
			}
		}

		&::details-content {
			background-color:   var(--background);
			block-size:         fit-content;
			box-shadow:         var(--shadow--border), var(--shadow--single);
			inset-block:        var(--anchor, anchor(end) auto);
			inset-inline-start: anchor(start);
			max-block-size:     calc(round(down, var(--safe), 2cap) - var(--3px)); /* Cut through a line. */
			max-inline-size:    round(max(79vw, 18ch), var(--1px));
			overflow-y:         scroll;
			position-anchor:    --nav-details;
			position-try:       flip-inline, --in-page;
			position:           fixed;
			scrollbar-width:    none;
		}

		> :is(ol, ul) {
			--resolve: 1cap;

			column-gap:            2cap;
			display:               grid;
			grid-template-columns: minmax(0, 1fr);
			justify-items:         start;
			padding-block:         var(--resolve);
			padding-inline:        2ex;
			row-gap:               var(--resolve);

			/* Room for indicator. */
			&:has([aria-current='page']) { padding-inline-start: 3ex }

			/* Pass columns down for Weeks/Projects with dates, external channels. */
			&:has(sub, a[href^="https"]) {
				grid-template-columns: minmax(0, 1fr) max-content;

				li {
					grid-column:           span 2;
					grid-template-columns: subgrid;
				}
			}

			li {
				display: inherit;
				row-gap: var(--resolve);

				a {
					align-items:           baseline;
					display:               inherit;
					grid-column:           inherit;
					grid-template-columns: inherit;
					block-size:            var(--resolve);

					/* Indicators. */
					&[aria-current='page']::before {
						content:          '◆' / '';
						inset-inline-end: calc(100% + 1ex);
						position:         absolute;
						text-box:         trim-both cap alphabetic;
					}

					&[href^="https"]::before {
						align-self:          end;
						background-image:    url('/assets/icons/&nearr.svg');
						background-position: center;
						background-repeat:   no-repeat;
						background-size:     var(--7px);
						block-size:          var(--7px);
						color:               transparent;
						content:             '↗' / '';
						inline-size:         var(--7px);
						order:               1;
					}

					/* Dates. */
					p:has(sub) {
						--family: 'Geneva';
						--size: var(--size--note);

						justify-self: end;
						text-align:   right;

						sub { display: block }
					}
				}

				> ol {
					--family:  'Geneva';
					--size:    var(--size--root);

					justify-items:       start;
					display:             inherit;
					margin-inline-start: var(--resolve);
					row-gap:             var(--resolve);

					ol {
						--size: var(--size--note);

						margin-inline-start: calc(2 * var(--resolve));
						row-gap:             var(--resolve);
					}
				}

				/* Drafts. */
				&:has(a:not([href])) {
					margin:         var(---3px);
					mask:           var(--background--check);
					padding:        var(--3px);
					pointer-events: none;
					user-select:    none;
				}
			}
		}

		/* Table of contents! */
		main & {
			--arrow:   180deg;
			--divider: 0 auto;
			--anchor:  auto calc(var(--ceiling) - var(--1px));

			/* TODO This is right/simpler but broken in Safari: */
			/* --anchor: auto calc(anchor(start) - var(--1px)); */

			&[open] { --arrow: initial }
		}
	}
</style>
<script webc:bucket="default">
	document.addEventListener('click', event =>
		document.querySelectorAll('nav details[open]').forEach(detail =>
			!detail.contains(event.target) && detail.removeAttribute('open')))

	document.addEventListener('keydown', event =>
		event.key === 'Escape' && document.querySelector('nav details[open]')?.removeAttribute('open'))
</script>
<details name="nav" webc:root="override">
	<summary :aria-label="initialCap(collection)" webc:keep webc:root="override">
		<svg webc:nokeep @html="inlineSvg(`assets/icons/nav/${collection}.svg`)"></svg>
		<svg webc:nokeep @html="inlineSvg('assets/icons/nav/drop.svg')"></svg>
	</summary>
	<ol webc:if="$data.collections[collection]">
		<li webc:for="item of $data.collections[collection]">
			<a :aria-current="item.url === $data.page.url && 'page'" :href="item.url">
				<p @html="item.data.title"></p>
				<p webc:if="collection != 'topics'"><sub @text="shortDate(item.data.date)"></sub></p>
			</a>
		</li>
	</ol>
	<ul webc:if="collection == 'channels'" @raw="getChannels($data)"></ul>
	<ol webc:if="collection == 'contents'">
		<li webc:if="$data.video"><a href="#session-recording">Session Recording</a></li>
		<template @raw="toc($data.content)" webc:nokeep></template>
	</ol>
</details>
