<style webc:bucket="components">
	details[name='nav'] {
		anchor-scope:   --nav-details;
		isolation:      isolate;
		pointer-events: auto;

		summary {
			anchor-name: --nav-details;
			box-shadow:  var(--shadow);
			user-select: none;
			z-index:     var(--stack, initial); /* Over ToC shadow. */

			/* Dotted line when open. */
			&::before {
				background-color: var(--background);
				block-size:       var(--1px);
				inset-block:      var(--divider, auto 0);
				inset-inline:     var(--1px);
				mask:             var(--background--check);
				position:         absolute;
				z-index:          1;

				/* Start pattern on white. */
				mask-position: var(--2px) 0;
			}

			/* Dropdown arrow. */
			svg:last-child:not(:only-of-type) {
				block-size: var(--3px);
				rotate:     var(--arrow, 0deg);
			}
		}

		&:where([open]) {
			--arrow:  180deg;
			--shadow: var(--shadow--border), var(--shadow--single);

			summary {
				--color: var(--background);

				* { --color: initial }

				&::before { content: '' }
			}
		}

		/* The “dropdown.” */
		&::details-content {
			background-color:    var(--background);
			block-size:          fit-content;
			box-shadow:          var(--shadow);
			inline-size:         max-content;
			inset-block:         var(--inset, calc(anchor(end) - var(--1px)) auto);
			margin-inline-start: var(--inline);
			max-block-size:      calc(round(down, var(--safe), 2cap) - var(--3px)); /* Cut through a line. */
			max-inline-size:     round(min(var(--limit, 100vw), 80vw), var(--1px));
			overflow-y:          scroll;
			position-anchor:     --nav-details;
			position-area:       var(--position, block-end) span-inline-start;
			position:            absolute;
			scrollbar-width:     none;

			@media (prefers-reduced-motion: no-preference) { scroll-behavior: smooth }
		}

		/* Does not like the `absolute`! */
		@supports (-moz-appearance: none) {
			display: grid;

			&::details-content {
				inset-block:       var(--inset, calc(var(--ceiling) - var(--1px)) auto);
				justify-self:      end;
				padding-block-end: var(--3px);
				position:          fixed;
			}
		}

		/* Limit Topics, ToC. */
		&:not(:has(sub, a[href^="https"])) { --limit: 25ch }
	}
</style>
<script webc:bucket="default">
	document.addEventListener('click', event =>
		document.querySelectorAll('nav details[open]').forEach(detail =>
			!detail.contains(event.target) && detail.removeAttribute('open')))

	document.addEventListener('keydown', event =>
		event.key === 'Escape' && document.querySelector('nav details[open]')?.removeAttribute('open'))
</script>
<details name="nav" webc:root="override">
	<summary :aria-label="initialCap(collection)" webc:keep webc:root="override">
		<svg webc:nokeep @html="inlineSvg(`assets/icons/nav/${collection}.svg`)"></svg>
		<svg webc:nokeep @html="inlineSvg('assets/icons/nav/drop.svg')"></svg>
	</summary>
	<nav-lists :@collection="collection"></nav-lists>
</details>
