<script webc:setup>
	export const channels = {
		submit: 'https://docs.google.com/forms/d/e/1FAIpQLSc3LUp6nqA1RTTloLM_u_xVHSNpcTQt3v2VG-L-HT9srsG_hA/viewform',
		slack:  'https://mpscd.slack.com/archives/C0BRNBPC6QP',
		figma:  'https://www.figma.com/files/team/1670950360853186233/all-projects',
		github: 'https://github.com/typography-interaction-2627',
		google: 'https://drive.google.com/drive/folders/1gxl_TpXu0Sd7oJbW1pk7Dd89VNpJwsHK',
		zoom:   'https://NewSchool.zoom.us/j/97800365415',
	}
</script>
<details>
	<summary @html="markdown(title || initialCap(collection))"></summary>
	<ul webc:if="collection">
		<li webc:for="item of $data.collections[collection]">
			<a :href="item.url">
				<p @html="item.data.title"></p>
				<p webc:if="collection != 'topics'" @text="displayDate(item.data.date)"></p>
			</a>
		</li>
	</ul>
	<ul webc:else>
		<li webc:for="(key, href) in channels">
			<a :href="href">
				<p @text="initialCap(key)"></p>
			</a>
		</li>
	</ul>
</details>
