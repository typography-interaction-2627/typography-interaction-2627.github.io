<style>
	details[name='nav'] {
		summary {
			/* Drop arrow. */
			svg:last-child:not(:only-of-type) {
				block-size: var(--3px);
				rotate:     var(--rotate);
			}
		}

		&[open] { --rotate: 180deg }

		&::details-content {
			background-color: var(--background);
			position:         absolute;
		}
	}
</style>
<details name="nav" webc:root="override">
	<summary :aria-label="initialCap(collection)" webc:keep webc:root="override">
		<svg webc:nokeep @html="inlineSvg(`assets/icons/nav/${collection?.replace(/s$/, '') || 'channels'}.svg`)"></svg>
		<p webc:if="collection" @text="initialCap(collection?.replace(/s$/, ''))"></p>
		<svg webc:nokeep @html="inlineSvg('assets/icons/nav/drop.svg')"></svg>
	</summary>
	<ul webc:if="collection">
		<li webc:for="item of $data.collections[collection]">
			<a :href="item.url">
				<p @html="item.data.title"></p>
				<p webc:if="collection != 'topics'" @text="displayDate(item.data.date)"></p>
			</a>
		</li>
	</ul>
	<channel-list webc:else></channel-list>
</details>
