<style>
	nav {
		--edge:    round(down, calc(var(--bleed) + var(--gutter) / 2), var(--1px)); /* Split gutter. */
		--inline:  var(--padding);
		--block:   var(--gutter);
		--padding: var(--4px);

		--size: 12;
		--wrap: nowrap;

		display:             flex;
		column-gap:          var(--inline);
		inline-size:         inherit; /* Rounded on-pattern, from `body`. */
		justify-content:     space-between;
		padding-block-start: var(--block);
		padding-inline:      var(--edge);
		position:            fixed;
		z-index:             1;

		> ul {
			column-gap: var(--inline);
			display:    flex;

			> li {
				> a, summary {
					align-items:      center;
					background-color: var(--color);
					column-gap:       var(--padding);
					display:          flex;
					padding:          var(--padding);

					* { --color: var(--background) }

					p { display: var(--labels, none) }

					svg {
						fill: var(--color);

						/* Type icons. */
						&:first-child { block-size: calc(9 * var(--1px)) }
					}
				}
			}
		}

		/* Center for lil’ phones. */
		@media (width <= 24.5em ) {
			--block: var(--inline);

			inline-size:        initial;
			inset-inline-start: round(down, 50%, var(--1px)); /* On-pattern. */
			translate:          round(-50%, var(--1px)) 0;

			> ul { display: contents } /* Treat as one list. */
		}

		@container style(--columns) {
			/* Split bleed, or align to island. */
			--edge:   round(max(calc(var(--bleed) / 2), calc(var(--safe) - var(--gutter))), var(--1px));
			--inline: var(--gutter);
		}

		@container style(--tablet) {
			/* Split bleed, even spacing. */
			--edge:    round(calc(var(--bleed) / 2), var(--1px));
			--inline:  var(--edge);
			--block:   var(--edge);
			--padding: 1ex;
		}

		@media (width >= 75em) { --labels: block }
	}
</style>
<nav webc:root="override">
	<ul>
		<li>
			<a aria-label="Home" href="/">
				<svg webc:nokeep @html="inlineSvg('assets/icons/nav/ampersand.svg')"></svg>
			</a>
		</li>
		<li>
			<a aria-label="Syllabus" href="/syllabus/">
				<svg webc:nokeep @html="inlineSvg('assets/icons/nav/syllabus.svg')"></svg>
				<p>Syllabus</p>
			</a>
		</li>
		<li>
			<a aria-label="Class" href="/class/">
				<svg webc:nokeep @html="inlineSvg('assets/icons/nav/class.svg')"></svg>
				<p>Class</p>
			</a>
		</li>
	</ul>
	<ul>
		<li>
			<nav-details @collection="weeks"></nav-details>
		</li>
		<li>
			<nav-details @collection="projects"></nav-details>
		</li>
		<li>
			<nav-details @collection="topics"></nav-details>
		</li>
		<li>
			<nav-details></nav-details>
		</li>
	</ul>
</nav>
