<style>
	/* TEMP! */
	nav {
		--wrap: nowrap;
		--edge: round(calc(var(--gutter) / 2), var(--1px));

		display:            flex;
		inset-inline:       0;
		justify-content:    space-between;
		margin-block-start: var(--edge);
		margin-inline:      var(--edge);
		position:           fixed;
		z-index:            1;

		> ul {
			--gap: 1ex;

			column-gap: var(--gap);
			display:    flex;

			> li {
				> a {
					background-color: var(--color);
					display:          flex;
					gap:              1ex;
					padding:          1ex;

					* { --color: var(--background) }

					p { display: none }

					svg {
						block-size: calc(9 * var(--1px));
						fill:       var(--color);
					}
				}
			}
		}
	}
</style>
<nav webc:root="override">
	<ul>
		<li>
			<a aria-label="Home" href="/">
				<svg webc:nokeep @html="inlineSvg('assets/icons/nav/ampersand.svg')"></svg>
			</a>
		</li>
		<li>
			<a aria-label="Syllabus" href="/syllabus/">
				<svg webc:nokeep @html="inlineSvg('assets/icons/nav/syllabus.svg')"></svg>
				<p>Syllabus</p>
			</a>
		</li>
		<li>
			<a aria-label="Class" href="/class/">
				<svg webc:nokeep @html="inlineSvg('assets/icons/nav/class.svg')"></svg>
				<p>Class</p>
			</a>
		</li>
	</ul>
	<!-- <ul>
		<li>
			<nav-details @collection="weeks" @title="Sessions"></nav-details>
		</li>
		<li>
			<nav-details @collection="projects"></nav-details>
		</li>
		<li>
			<nav-details @collection="topics"></nav-details>
		</li>
		<li>
			<nav-details @title="Elsewhere"></nav-details>
		</li>
	</ul> -->
</nav>
