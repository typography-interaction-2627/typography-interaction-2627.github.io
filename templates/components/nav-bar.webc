<nav>
	<ul>
		<li webc:for="item of $data.collections.root">
			<a :href="item.url">
				<p @html="capitalize(item.fileSlug) || '&'"></p>
			</a>
		</li>
		<li>
			<nav-details :@collection="$data.collections.weeks" @title="Sessions">
				<p @html="item.data.title"></p>
				<p @text="displayDate(item.data.date)"></p>
			</nav-details>
		</li>
		<li>
			<nav-details :@collection="$data.collections.projects" @title="Projects">
				<p @html="item.data.title"></p>
				<p @text="displayDate(item.data.date)"></p>
			</nav-details>
		</li>
		<li>
			<nav-details :@collection="$data.collections.topics" @title="Topics">
				<p @html="item.data.title"></p>
				<p @text="displayDate(item.data.date)"></p>
			</nav-details>
		</li>
	</ul>
</nav>
