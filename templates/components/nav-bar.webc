<style>
	/* TEMP! */
	nav {
		--wrap: nowrap;
		--edge: round(calc(var(--gutter) / 2), var(--1px));

		align-items:        center;
		display:            flex;
		flex-direction:     column;
		inset-inline:       0;
		margin-block-start: var(--gutter);
		margin-inline:      var(--edge);
		position:           fixed;
		row-gap:            var(--edge);
		z-index:            1;

		@media (width > 42em) {
			flex-direction:     row;
			justify-content:    space-between;
			margin-block-start: var(--edge);
		}

		> ul {
			--gap: round(1ex, var(--1px));

			column-gap: var(--gap);
			display:    flex;

			> li > a {
				padding:          round(1ex, var(--1px));
				background-color: var(--color);

				* { --color: var(--background) }
			}

			/* Logo. */
			&:first-child > li:first-child { --family: 'New York' }
		}
	}
</style>
<nav webc:root="override">
	<ul>
		<li webc:for="item of $data.collections.root">
			<a :href="item.url">
				<p @html="initialCap(item.fileSlug) || '&'"></p>
			</a>
		</li>
		<!--
		<li>
			<nav-details @collection="weeks" @title="Sessions"></nav-details>
		</li>
		<li>
			<nav-details @collection="projects"></nav-details>
		</li>
		<li>
			<nav-details @collection="topics"></nav-details>
		</li>
		<li>
			<nav-details @title="Elsewhere"></nav-details>
		</li>
		-->
	</ul>
	<!-- Temp for first class! 🫣 -->
	<ul>
		<li>
			<a href="/week/1/">
				<p>Week 1</p>
			</a>
		</li>
		<li>
			<a href="/topic/everything/">
				<p><em>Everything</em></p>
			</a>
		</li>
	</ul>
</nav>
