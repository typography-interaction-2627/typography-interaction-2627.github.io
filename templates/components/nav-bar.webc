		--family: 'Chicago';
		--size:   12;
		--wrap:   nowrap;

		display:         flex;
		column-gap:      var(--inline);
		inline-size:     inherit; /* Rounded on-pattern, from `body`. */
		justify-content: space-between;
		padding-block:   var(--block);
		padding-inline:  var(--edge);
		position:        fixed;
		z-index:         1;
		pointer-events:  none;

		> ul {
			column-gap: var(--inline);
			display:    flex;

			> li {
				> a, summary {
					align-items:      center;
					background-color: var(--color);
					column-gap:       var(--padding);
					display:          flex;
					padding:          var(--padding);

					* { --color: var(--background) }

					svg {
						fill: var(--color);

						/* Type icons. */
						&:first-child { block-size: calc(9 * var(--1px)) }
					}
				}
			}
		}

		@media (width > 24.5em ) {
			/* Split gutter. */
			--edge: round(down, calc(var(--bleed) + var(--gutter) / 2), var(--1px));
		}

		@container style(--columns) {
			/* Split bleed, or align to island. */
			--edge:   round(max(calc(var(--bleed) / 2), calc(var(--safe) - var(--gutter))), var(--1px));
			--inline: var(--gutter);
		}

		@container style(--tablet) {
			/* Split bleed, even spacing. */
			--edge:    round(calc(var(--bleed) / 2), var(--1px));
			--inline:  var(--edge);
			--block:   var(--edge);
			--padding: 1ex;
		}
	}
</style>
