<script webc:setup>
	export const rootLinks = [
		{
			label: 'Home',
			url:   '/',
			icon:  'ampersand',
		},
		{ url: '/syllabus/' },
		{ url: '/class/' },
	]
</script>
<style>
	nav {
		--block:      var(--gutter);
		--block--toc: calc(var(--gutter) + var(--peek));
		--inline:     var(--bleed);
		--gap:        var(--padding);

		--padding:    var(--4px);
		--icon:       calc(9 * var(--1px));
		--nav:        calc(2 * var(--padding) + var(--icon));

		--ceiling: calc(var(--block) + var(--nav)); /* Inside edge of nav. */
		--floor:   var(--gutter);
		--safe:    calc(var(--dvh) - var(--ceiling) - var(--floor) - var(--gap));

		--family: 'Chicago';
		--size:   12;
		--wrap:   nowrap;

		column-gap:          var(--gap);
		display:             flex;
		inline-size:         round(var(--vw), var(--1px));
		isolation:           isolate;
		justify-content:     space-between;
		padding-block-start: var(--block);
		padding-inline:      var(--inline);
		pointer-events:      none;
		position:            fixed;
		z-index:             1;

		> ul {
			column-gap: var(--gap);
			display:    flex;
		}

		> ul > li > a, summary {
			align-items:      center;
			background-color: var(--color);
			column-gap:       var(--padding);
			display:          flex;
			padding:          var(--padding);
			pointer-events:   auto; /* TODO Unravel this better! See `nav-details` overlap. */

			* { --color: var(--background) }

			svg {
				fill: var(--color);

				/* Type icons. */
				&:first-child { block-size: var(--icon) }
			}
		}

		/* Prevent collisions when there is a ToC. */
		body:has(main > nav) & { --floor: calc(var(--block--toc) + var(--nav)) }

		@media (width > 24.5em ) {
			/* Split gutter. */
			--inline: round(down, calc(var(--bleed) + var(--gutter) / 2), var(--1px));
		}

		@container style(--columns) {
			/* Split bleed, or align to island. */
			--inline: round(max(calc(var(--bleed) / 2), calc(var(--notch) - var(--gutter))), var(--1px));
			--gap:    var(--gutter);
		}

		@container style(--tablet) {
			/* Even spacing, split bleed. */
			--block:      var(--inline);
			--block--toc: var(--block);
			--inline:     round(calc(var(--bleed) / 2), var(--1px));
			--gap:        var(--inline);
			--padding:    1ex;
		}
	}
</style>
<nav webc:root="override">
	<ul>
		<li webc:for="link of rootLinks">
			<a :aria-current="$data.page.url === link.url && 'page'" :aria-label="link.label ?? initialCap(link.url.replaceAll('/', ''))" :href="link.url">
				<svg webc:nokeep @html="inlineSvg(`assets/icons/nav/${link.icon ?? link.url.replaceAll('/', '')}.svg`)"></svg>
			</a>
		</li>
	</ul>
	<ul>
		<li>
			<nav-details @collection="weeks"></nav-details>
		</li>
		<li>
			<nav-details @collection="projects"></nav-details>
		</li>
		<li>
			<nav-details @collection="topics"></nav-details>
		</li>
		<li>
			<nav-details @collection="channels"></nav-details>
		</li>
	</ul>
</nav>
