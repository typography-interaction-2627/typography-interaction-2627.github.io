<style>
	header:has(h1) {
		block-size:     round(100svh, var(--1px));
		display:        grid;
		overflow:       clip;
		padding-inline: calc(var(--gutter) + var(--bleed));
		place-content:  center;
		/* TODO With transform/translate, for sub-px? */

		hgroup {
			--gap: round(calc(1lh - 1ex), var(--1px));

			display:     grid;
			place-items: center;
			row-gap:     var(--gap);
			text-align:  center;

			div {
				--family: 'Geneva';
				--size:   var(--size--root);
				--kerning: initial;
			}

			/* Only on “interior” pages (not landing). */
			@container style(--color: black) {
				--gap: round(0.5ex, var(--1px));

				background-color: var(--background);
				border:           var(--border);
				box-shadow:       var(--shadow--double);
				padding:          var(--gap);
			}
		}

	}

	/* Meta sidecar. */
	:root:has(body > header:only-child) {
		--scaling: 3;

		header { padding-inline: var(--bleed) }
	}
</style>
<header webc:root="override">
	<hgroup>
		<h1 @html="(meta ?? $data).title"></h1>
		<div webc:if="(meta ?? $data).date || (meta ?? $data).page.url === '/'">
			<p>
				<time webc:if="(meta ?? $data).date" @html="displayDate((meta ?? $data).date)"></time>
				<time webc:else>2026–2027</time>
			</p>
		</div>
	</hgroup>
</header>
