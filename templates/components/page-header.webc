<style>
	header:has(h1) {
		block-size: round(100svh, var(--1px));
		overflow:   clip;
		position:   relative;

		hgroup {
			--gap: var(--rhythm);

			display:            grid;
			inline-size:        max-content;
			inset-block-start:  round(down, 50%, var(--1px));
			inset-inline-start: round(down, 50%, var(--1px));
			max-inline-size:    var(--main);
			min-inline-size:    min-content;
			place-items:        center;
			position:           absolute;
			row-gap:            var(--gap);
			text-align:         center;
			translate:          round(-50%, var(--1px)) round(-50%, var(--1px));
			/* Centered with `transform` to always land on-pattern. */

			div {
				--family: 'Geneva';
				--size:   var(--size--root);
				--kerning: initial;
			}

			/* Only on “interior” pages (not landing). */
			@container style(--color: black) {
				--gap: round(0.5ex, var(--1px));

				background-color: var(--background);
				box-shadow:       var(--shadow--border), var(--shadow--double);
				padding:          calc(var(--gap) + var(--1px));
			}
		}

	}

	/* Meta sidecar. */
	:root:has(body > header:only-child) {
		--scaling: 3;

		hgroup { max-inline-size: var(--page) }
	}
</style>
<header webc:root="override">
	<hgroup>
		<h1 :aria-label="stripTags((meta ?? $data).title)" @html="letterSpans((meta ?? $data).title)"></h1>
		<div webc:if="(meta ?? $data).date || (meta ?? $data).page.url === '/'">
			<p>
				<time webc:if="(meta ?? $data).date" @html="displayDate((meta ?? $data).date)"></time>
				<time webc:else>2026–2027</time>
			</p>
		</div>
	</hgroup>
</header>
