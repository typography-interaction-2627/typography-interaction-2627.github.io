<style webc:root="override" webc:if="meta?.data?.sequence || $data.sequence"
	@raw="` body { background-image: url('/assets/patterns/${meta?.data?.sequence || $data.sequence}.svg') }`">
</style>
<style webc:root="override" webc:else>
	body > header {
		--color:      white;
		--background: black;
	}
</style>
<style webc:bucket="components">
	body { background-size: var(--8px) }
</style>
