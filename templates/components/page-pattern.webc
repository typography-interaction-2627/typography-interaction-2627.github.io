<style webc:root="override" webc:if="(meta ?? $data).sequence"
	@raw="`:root { --background--pattern: url('/assets/patterns/${(meta ?? $data).sequence}.svg') }`">
</style>
<style webc:root="override" webc:else>
	body > header {
		--color:      white;
		--background: black;
	}
</style>
<style webc:bucket="components">
	html { background-color: black } /* Landing page and iOS “forehead.” */

	body {
		background-image: var(--background--pattern);
		background-size:  var(--8px);
	}
</style>
