<style webc:bucket="components">
	/* Overrides for `nav-bar.webc` */
	main > nav {
		--arrow:    180deg;
		--divider:  0 auto;
		--inset:    auto var(---1px);
		--position: block-start;
		--stack:    1;
		--start:    round(calc(var(--dvh) - var(--block--toc) - var(--nav)), var(--1px)); /* On-pattern. */

		inset-block-start:   var(--start);
		justify-content:     end;
		padding-block-end:   var(--block--toc);
		padding-block-start: initial;

		[open] { --arrow: initial }

		@supports (-moz-appearance: none) { --inset: auto calc(var(--svh) - var(--start) - var(--1px)) }
	}
</style>
<nav webc:root="override">
	<nav-details @collection="contents"></nav-details>
</nav>
