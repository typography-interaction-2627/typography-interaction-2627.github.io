<style>
	/* Overrides for `nav.webc` */
	main > nav {
		inset-block-start:   round(calc(var(--svh) - var(--block--toc) - var(--nav)), var(--1px)); /* On-pattern. */
		justify-content:     end;
		padding-block-end:   var(--block--toc);
		padding-block-start: initial;
	}
</style>
<nav webc:root="override">
	<nav-details @collection="contents"></nav-details>
</nav>
