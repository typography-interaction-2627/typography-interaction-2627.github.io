<style>
	hgroup:has(h2[id^="session-recording"]) ~ figure {
		margin-block-start: initial;

		@container style(--columns) { &:not(:first-of-type) { margin-block-start: 1rlh } }

		p { min-block-size: 1cap }

		p > span:nth-child(2) { display: none }

		/* Hide for Safari, toggle note. */
		@supports (font: -apple-system-body) {
			justify-self:       start;
			margin-block-start: initial;

			div, p > span:first-of-type { display: none }

			p > span:last-of-type  { display: initial }
		}
	}
</style>
<script webc:setup>
	export const recordingLabel = video => pluralize('Session Recording', toArray(video).length)
	export const recordingId = video => slugify(recordingLabel(video))
</script>
<section webc:root="override">
	<hgroup>
		<h2 :id="recordingId($data.video)" tabindex="-1"><span webc:nokeep @text="recordingLabel($data.video)"></span><a :href="`#${recordingId($data.video)}`">#</a></h2>
	</hgroup>
	<figure class="all justify-center" webc:for="video, index of toArray($data.video)">
		<div>
			<iframe :src="`https://drive.google.com/file/d/${video}/preview`"></iframe>
		</div>
		<figcaption>
			<p>
				<span webc:if="index === 0">You’ll need to be <a href="https://accounts.google.com/AccountChooser">signed in</a> to your New School account to see <a :href="`https://drive.google.com/file/d/${video}`">this recording</a> in-page!</span>
				<span webc:if="index === 0">Safari prevents Google Drive <nobr>embeds—</nobr>so you’ll need to go to <a :href="`https://drive.google.com/file/d/${video}`">the original</a>!</span>
				<span webc:if="index > 0">And <a :href="`https://drive.google.com/file/d/${video}`">the original</a> for this one!</span>
				<a :href="`https://drive.google.com/file/d/${video}`"><cite>↗</cite></a>
			</p>
		</figcaption>
	</figure>
</section>
