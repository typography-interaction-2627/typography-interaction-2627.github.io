<style>
	hgroup:has(h2[id^="session-recording"]) ~ figure {
		margin-block-start: calc(var(--gutter) - 1rlh);

		p > span:last-of-type { display: none }

		/* Hide for Safari, toggle note. */
		@supports (font: -apple-system-body) {
			div, p > span:first-of-type { display: none }
			p > span:last-of-type  { display: initial }
		}
	}
</style>
<script webc:setup>
	export const recordingLabel = video => pluralize('Session Recording', toArray(video).length)
	export const recordingId = video => slugify(recordingLabel(video))
</script>
<section webc:root="override">
	<hgroup>
		<h2 :id="recordingId($data.video)" tabindex="-1"><span webc:nokeep @text="recordingLabel($data.video)"></span><a :href="`#${recordingId($data.video)}`">#</a></h2>
	</hgroup>
	<figure webc:for="video of toArray($data.video)">
		<div>
			<iframe :src="`https://drive.google.com/file/d/${video}/preview`"></iframe>
		</div>
		<figcaption>
			<p>
				<span>You’ll need to be <a href="https://accounts.google.com/AccountChooser">signed in</a> to your New School account to see these in-page!</span>
				<span>Safari prevents Google Drive <nobr>embeds—</nobr>so you’ll need to go to <a :href="`https://drive.google.com/file/d/${video}`">the originals</a>!</span>
				<a :href="`https://drive.google.com/file/d/${video}`"><cite>↗</cite></a>
			</p>
		</figcaption>
	</figure>
</section>
