<template webc:bucket="base" webc:nokeep>
	<link href="../../assets/styles/variables.css"  rel="stylesheet">
	<link href="../../assets/styles/fonts.css"      rel="stylesheet">
	<link href="../../assets/styles/typography.css" rel="stylesheet">
	<link href="../../assets/styles/links.css"      rel="stylesheet">
	<link href="../../assets/styles/code.css"       rel="stylesheet">
</template>
<style webc:keep
	@raw="`
		@layer reset, base, components, inline, print;

		@import url('/assets/reset.css')                        layer(reset);
		@import url('${getBundleFileUrl('css', 'base')}')       layer(base);
		@import url('${getBundleFileUrl('css', 'components')}') layer(components);
		@import url('${getBundleFileUrl('css', 'print')}')      layer(print) print;
	`"
></style>
<style webc:keep @raw="`@layer inline { ${getBundle('css')} }`"></style>
<link webc:keep :href="getBundleFileUrl('css', 'unlayered')" rel="stylesheet">
