<style webc:bucket="components">
	main {
		margin-block-start: calc(-1 * var(--gutter));
		/* Space above anchor destination. */
		[id]   { scroll-margin-block: var(--gutter) }
		h2[id] { scroll-margin-block: calc(2 * var(--gutter)) }

		/* Our “windows.” */
		&:not(:has(> section)), > section {
			align-items:         baseline;
			background-color:    var(--background);
			border:              var(--border);
			box-shadow:          var(--shadow--single);
			column-gap:          var(--alley);
			display:             grid;
			grid-auto-rows:      min-content;
			inline-size:         var(--page);
			margin-inline-end:   var(--bleed);
			margin-inline-start: var(--bleed--round, var(--bleed));
			padding-block-end:   calc(2 * var(--gutter));
			padding-block-start: var(--gutter);
			padding-inline:      var(--gutter);
			row-gap:             var(--line);

			grid-template-columns:
				[ all-start aside-start body-start middle-start five-start four-start intro-start left-start one-start recto-start right-start six-start three-start two-start verso-start ]
				minmax(0, 1fr)
				[ all-end aside-end body-end middle-end five-end four-end intro-end left-end one-end recto-end right-end six-end three-end two-end verso-end ];

			/* Between “windows.“ */
			&:not(:first-of-type) { margin-block-start: round(20vh, var(--1px)) }

			/* Default to body width. */
			:where(&, details, section) > * { grid-column: body }

			/* Limit paragraphs (inside things), sameish. */
			:where(p) { max-inline-size: 55ch }

			/* Containers. */
			details,
			div,
			dl,
			ol,
			section,
			ul {
				align-items:           inherit;
				display:               grid;
				grid-template-columns: minmax(0, 1fr);
				row-gap:               inherit;
			}

			/* Subgridded `section`. */
			details, section {
				grid-column:           all;
				grid-template-columns: subgrid;
			}

			/* The actual columns. */
			@container style(--columns: 6) {
				grid-template-columns:
					[ all-start body-start intro-start left-start one-start verso-start ]
					minmax(0, 1fr)
					[ aside-start one-end two-start]
					minmax(0, 1fr)
					[ middle-start left-end three-start two-end ]
					minmax(0, 1fr)
					[four-start recto-start three-end verso-end]
					minmax(0, 1fr)
					[ body-end middle-end five-start four-end right-start ]
					minmax(0, 1fr)
					[ intro-end five-end six-start]
					minmax(0, 1fr)
					[ all-end aside-end recto-end right-end six-end];
			}
		}

		/* Headings */
		hgroup {
			:where(h2, h3, h4) {
				--resolve: 1cap; /* Pass this down. */

				inline-size:     fit-content;
				max-inline-size: 100%; /* Retain wrapping! */

				/* Anchor links. */
				a:empty {
					--family: 'Geneva';
					--size:   14;

					block-size:          var(--8px);
					display:             inline-grid;
					font-weight:         normal;
					inline-size:         var(--8px);
					margin-inline-start: round(calc(var(--resolve) / 3), var(--1px));
					opacity:             var(--opacity);
					text-box:            trim-both cap alphabetic;
					transition-delay:    var(--delay, 1s); /* “Coyote time.” */
					translate:           0 round(down, calc(-1 * var(--resolve) + var(--8px)), var(--1px));

					&::before {
						content:    '#';
						place-self: end;
						position:   absolute;
						text-box:   trim-both cap alphabetic;
						translate:  0 var(--3px); /* The hash glyph is weirdly high/small! */
					}
				}
			}

			/* Dividers. */
			&:has(h2, h3, h4) { grid-column: all }

			&:has(h2) {
				border-block-end:  var(--border);
				margin-inline:     calc(-1 * var(--gutter));
				padding-block-end: var(--gutter);
				padding-inline:    var(--gutter);

				+ * { margin-block-start: 1rlh }
			}

			&:has(h3) + * { margin-block-start: 1rlh }

			&:has(h4) { margin-block-start:  1rlh }
		}

		/* Not right after `h2`. */
		section section:not(hgroup + section) > hgroup:has(h3) {
			background-image:    url('patterns/dash.svg');
			background-repeat:   repeat-x;
			background-size:     var(--2px) var(--1px);
			margin-block-start:  2rlh;
			padding-block-start: 1cap;
		}

		/* Toggle anchor links. */
		@media (any-hover: hover) {
			section {
				:is(h2, h3, h4) { --opacity: 0 }

				/* Only show when its own/immediate content is hovered. */
				:is(h2, h3, h4):hover,
				&:has(> :hover:not(section, hgroup)) > hgroup > :is(h2, h3, h4),
				a:empty:focus:focus-visible {
					--opacity: 1;
					--delay:   0;
				}
			}
		}

		/* Cinch solo `cite` (for `:hover`). */
		p:has(> a > cite) { inline-size: fit-content }
	}
</style>
<script>
	console.log('yo!')
	const main = document.querySelector('main')
	const hash = window.location.hash.slice(1)

	const sections = new Set()

	// Update the hash while scrolling through.
	const observeSections = () => {
		main.querySelectorAll('[id]:not(figure)').forEach((id) => {
			if (id.closest('[inert]')) return

			const section = id.closest('section')

			if (section && !sections.has(section)) {
				sections.add(section)

				new IntersectionObserver(
					([entry]) => {
						(entry.isIntersecting)
							? history.replaceState(null, '', `#${section.querySelector('[id]')?.id}`)
							: ((section === ([...sections][0]) && entry.boundingClientRect.top >= 0)
								|| (section === ([...sections].at(-1)) && entry.boundingClientRect.top <= 0)) &&
									history.replaceState(null, '', window.location.pathname + window.location.search)
					},
					{
						rootMargin:
							section.matches('main > section:first-child')
								? '0% 0% -33%'
								: section.matches('main > section:last-child')
									? '0% 0% -50%'
									: '-50% 0%',
					},
				).observe(section)
			}
		})
	}

	// After any anchoring.
	(!hash)
		? observeSections()
		: setTimeout(observeSections, 1500)
</script>
<main webc:root="override" webc:bucket="default" @html="content"></main>
