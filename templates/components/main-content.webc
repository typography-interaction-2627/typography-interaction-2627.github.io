<style>
	main {
		/* Our “windows.” */
		&:not(:has(> section)), > section {
			background-color:  var(--background);
			border:            var(--border);
			box-shadow:        var(--shadow);
			inline-size:       var(--page);
			margin-inline:     var(--gutter--outer);
			padding-inline:    var(--gutter--inner);
			padding-block-end: calc(2 * var(--8px));

			&:not(:first-of-type) { margin-block-start: round(20vh, var(--1px)) }
		}

		/* Headings */
		hgroup {
			--resolve: 1cap; /* Pass this down. */

			inline-size: fit-content;

			/* Anchor links. */
			a:empty {
				--family: 'Geneva';
				--size:   14;

				block-size:          var(--8px);
				display:             inline-grid;
				font-weight:         normal;
				inline-size:         var(--8px);
				margin-inline-start: round(calc(var(--resolve) / 3), var(--1px));
				opacity:             var(--opacity);
				text-box:            trim-both cap alphabetic;
				transition-delay:    var(--delay, 1s); /* “Coyote time.” */
				translate:           0 round(down, calc(-1 * var(--resolve) + var(--8px)), var(--1px));

				&::before {
					content:    '#';
					place-self: end;
					position:   absolute;
					text-box:   trim-both cap alphabetic;
					translate:  0 var(--3px); /* The hash glyph is weirdly high/small! */
				}
			}
		}

		/* Toggle the anchor links. */
		@media (any-hover: hover) {
			section {
				> hgroup { --opacity: 0 }

				/* Only show when its own/immediate content is hovered. */
				&:has(> :hover:not(section)) > hgroup {
					--opacity: 1;
					--delay:   0;
				}
			}
		}

		/* Cinch solo `cite` (for `:hover`). */
		p:has(> a > cite) { inline-size: fit-content }

		/* TEMP! */
		> *, section > * { margin-top: calc(2 * var(--8px)) }
		p { max-width: 65ch }
	}
</style>
<main webc:root="override" webc:bucket="components" @html="content"></main>
