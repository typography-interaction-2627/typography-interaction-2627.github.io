<script webc:setup>
	export const syllabusSemester = ({ page, currentWeek }) =>
		page.url == '/syllabus/' && currentWeek < 15 ? 'fall' : 'spring'
</script>
<style webc:bucket="components">
	main {
		--anchor: calc(9 * var(--gutter)); /* Adjust with the `nav`! */

		@media (width > 42em) { --anchor: calc(3 * var(--gutter)) }

		display:            grid;
		isolation:          isolate; /* Internal `z-index`. */
		margin-block-start: calc(-1 * var(--gutter)); /* Peek above fold. */
		row-gap:            var(--break); /* Between “windows.“ */

		/* Space above anchor destination. */
		[id]   { scroll-margin-block: var(--anchor) }
		h2[id] { scroll-margin-block: calc(var(--anchor) + var(--gutter)) }

		/* Print-only. */
		.print { display: none }

		/* Our “windows.” */
		&:not(:has(> section)), > section {
			align-items:         baseline;
			background-color:    var(--background);
			box-shadow:          var(--shadow--border), var(--shadow--single);
			column-gap:          var(--alley);
			display:             grid;
			grid-auto-rows:      min-content;
			inline-size:         var(--page);
			margin-inline-end:   var(--bleed);
			margin-inline-start: var(--bleed--round, var(--bleed));
			padding-block-end:   calc(2 * var(--gutter) + var(--1px));
			padding-block-start: calc(var(--gutter) + var(--1px));
			padding-inline:      calc(var(--gutter) + var(--1px));
			row-gap:             var(--line);

			grid-template-columns:
				[ all-start aside-start body-start middle-start five-start four-start left-start one-start recto-start right-start six-start three-start two-start verso-start ]
				minmax(0, 1fr)
				[ all-end aside-end body-end middle-end five-end four-end left-end one-end recto-end right-end six-end three-end two-end verso-end ];

			/* Default to body width. */
			:where(&, details, section) > * { grid-column: body }

			/* Limit paragraphs (inside things), sameish. */
			:where(p) { max-inline-size: 55ch }

			/* Containers. */
			:where(details, div, dl, ol, section, ul) {
				align-items:           inherit;
				display:               grid;
				grid-template-columns: minmax(0, 1fr);
				row-gap:               inherit;
			}

			/* Subgridded `section`. */
			:where(details, section) {
				grid-column:           all;
				grid-template-columns: subgrid;
			}

			/* Inserted in Markdown. */
			:where(section:not(:has(> hgroup))) {
				margin-block-start: round(1rlh, var(--1px));

				+ * { margin-block-start: round(1rlh, var(--1px)) }
			}

			:where(details):not(:first-child) { margin-block-start: round(1rlh, var(--1px)) }

			/* Manual column placements. */
			:where(div, .all, .aside, .body, .middle, .five, .four, .left, .one, .recto, .right, .six, .three, .two, .verso) {
				grid-row: span var(--rows, 1);

				* { grid-column: initial }
			}

			/* Some `--rows` shorthands. */
			.rows--2 { --rows: 2 }
			.rows--3 { --rows: 3 }
			.rows--4 { --rows: 4 }
			.rows--5 { --rows: 5 }
			.rows--6 { --rows: 6 }

			/* TODO Organize these! */
			.start  { align-self: start }
			.stack  { figure { margin: initial } }
			.center { align-self: center }
			.end    { align-self: end }

			*:has(> .sticky) {
				block-size: 100%;

				.sticky {
					inset-block-start: 4rlh;
					position:          sticky;
				}
			}

			/* Only when on The Grid. */
			:where(&, section) {
				> .all    { grid-column: all }
				> .aside  { grid-column: aside }
				> .body   { grid-column: body }
				> .five   { grid-column: five }
				> .four   { grid-column: four }
				> .left   { grid-column: left }
				> .middle { grid-column: middle }
				> .one    { grid-column: one }
				> .recto  { grid-column: recto }
				> .right  { grid-column: right }
				> .six    { grid-column: six }
				> .three  { grid-column: three }
				> .two    { grid-column: two }
				> .verso  { grid-column: verso }
			}

			/* The actual columns. */
			@container style(--columns: 6) {
				grid-template-columns:
					[ all-start body-start left-start one-start verso-start ]
					minmax(0, 1fr)
					[ aside-start one-end two-start]
					minmax(0, 1fr)
					[ middle-start left-end three-start two-end ]
					minmax(0, 1fr)
					[four-start recto-start three-end verso-end]
					minmax(0, 1fr)
					[ body-end middle-end five-start four-end right-start ]
					minmax(0, 1fr)
					[ aside-end five-end six-start]
					minmax(0, 1fr)
					[ all-end recto-end right-end six-end];
			}
		}

		/* TODO Could make a separate `.webc` for this? */
		/* TODO Move these to select the parent `section`! */
		/* Headings */
		:where(hgroup) {
			:where(h2, h3, h4) {
				--resolve: 1cap; /* Pass this down. */

				inline-size:     fit-content;
				max-inline-size: 100%; /* Retain wrapping! */

				/* Anchor links. */
				/* TODO These wrap to next line! At least after `em`. */
				a:empty {
					--family: 'Geneva';
					--size:   14;

					block-size:          var(--8px);
					display:             inline-grid;
					font-weight:         normal;
					inline-size:         var(--8px);
					margin-inline-start: round(calc(var(--resolve) / 3), var(--1px));
					opacity:             var(--opacity);
					text-box:            trim-both cap alphabetic;
					transition-delay:    var(--delay, 1s); /* “Coyote time.” */
					translate:           0 round(down, calc(-1 * var(--resolve) + var(--8px)), var(--1px));

					/* TODO Unravel this! Shouldn’t need the override. */
					@supports (not (font: -apple-system-body)) and (not (-moz-appearance: none)) { --font: 'Geneva 14' }

					&::before {
						content:    '#';
						place-self: end;
						position:   absolute;
						text-box:   trim-both cap alphabetic;
						translate:  0 var(--3px); /* The hash glyph is weirdly high/small! */
					}
				}
			}

			/* Dividers. */
			&:has(h2, h3, h4) { grid-column: all }

			&:has(h2) {
				background:        var(--background--border);
				margin-inline:     calc(-1 * var(--gutter));
				padding-block-end: calc(var(--gutter) + var(--1px));
				padding-inline:    var(--gutter);
				position:          relative;

				+ * { margin-block-start: round(1rlh, var(--1px)) }
			}

			&:has(h3) {
				/* Not right after `h2`. */
				section section:not(hgroup + section) > & {
					background:          var(--background--dashed);
					margin-block-start:  round(2rlh, var(--1px));
					padding-block-start: round(1cap, var(--1px));

					/* Override default bottom-edge. */
					background-position-y: top;
				}

				+ * { margin-block-start: round(1rlh, var(--1px)) }
			}

			&:has(h4) { margin-block-start:  round(1rlh, var(--1px)) }
		}

		/* Toggle anchor links. */
		@media (any-hover: hover) {
			section {
				:is(h2, h3, h4) { --opacity: 0 }

				/* Only show when its own/immediate content is hovered. */
				:is(h2, h3, h4):hover,
				&:has(> :hover:not(section, hgroup)) > hgroup > :is(h2, h3, h4),
				a:empty:focus:focus-visible {
					--opacity: 1;
					--delay:   0;
				}
			}
		}

		:where(hr) {
			background:        var(--background--border);
			grid-column:       all;
			margin-block:      var(--gutter);
			margin-inline:     calc(-1 * var(--gutter));
			padding-block-end: var(--1px);
		}

		/* Née ”intro.” */
		:where(p:has(> strong:only-child)) {
			--size:    var(--size--h4);
			--leading: round(1rlh, var(--1px));
			--wrap:    balance;

			*:not(hgroup) + & { margin-block-start: round(1rlh, var(--1px)) }

			> strong { display: block } /* Fixes `line-height` rounding. 🤷‍♀️ */

			@container style(--columns: 6) {
				&:where(:not(:has(~ .right))) { grid-column: all-start / five-end }
			}

			+ *:not(section) { margin-block-start: round(1rlh, var(--1px)) }
		}

		/* Previously “note.” */
		:where(p:has(> sub:only-child)) {
			--family:  'Geneva';
			--size:    var(--size--note);
			--leading: round(1rlh, var(--1px));
			--wrap:    balance;

			> sub { display: block }
		}

		/* Some automatic balancin’. */
		:where(section, li) > p:only-of-type,
		:where(section, li) > p:first-of-type:has(+ p:last-child > a > cite),
		:where(section, li) > *:not(p) + p:has(+ *:not(p)) {
			--wrap: balance;
		}

		/* Lists, lists, lists. */
		:is(dl, ol, ul) {
			/* Extra spacing around loosies. */
			&:where(:not([class], :first-child)) {
				margin-block-start: round(1rlh, var(--1px));

				&:where(:not(:last-child)) + * {
					margin-block-start: round(1rlh, var(--1px));

					@container style(--columns: 6) { + *:where(.recto, .right) { margin-block-start: 1rlh } }
				}
			}

			/* Not `cite` lists. */
			&:where(:not(:has(> li > a > cite, > li > p:only-child > a > cite))) {
			/* TODO There still has to be a simpler way to check for these! */

				/* Item inset. */
				> :where(dd, dt, li) { padding-inline-start: var(--line) }

				> :where(dt, li) {
					position: relative;

					/* ”Markers.” */
					&::before {
						content:            '•' / '';
						inset-inline-start: 0;
						position:           absolute;

						/* Bill did not draw us a decorative bullet! */
						@container style(--family: 'Venice') { font-family: 'Geneva', serif }
					}

					&:has(p)::before { text-box: trim-both cap alphabetic } /* Match for “loose” ones. */

					[inert] & {
						background: var(--check--text);
						color:      transparent;
					}
				}
			}

			/* “Tight” lists. */
			&:where(:not(:has(li > p))) { row-gap: var(--lead) }

			/* More vertical space when the items have multiple paragraphs. */
			&:where(:has(:where(dt, li) > p:not(:only-child))) {
				margin-block-start: round(1rlh, var(--1px));
				row-gap:            calc(var(--line) + round(1rlh, var(--1px)));

				> :where(dt, li):where(:has(p:not(:only-child))) {
					display:               grid;
					grid-template-columns: minmax(0, 1fr);
					row-gap:               var(--line); /* Back to `main` spacing. */
				}
			}
		}

		:where(dl) {
			row-gap: inherit;

			> dt {
				&:where(:not(:first-of-type)) { margin-block-start: round(1rlh, var(--1px)) }
			}
		}

		/* Tables for the grade breakdown. */
		:where(table) {
			inline-size: fit-content;

			td:not(:first-child), th:not(:first-child) {
				border-inline-start: calc(var(--line) - var(--left) - var(--right)) solid transparent;
			}

			tr:not(:first-child) td, tr:not(:first-child) th { border-block-start: 1cap solid transparent }
		}

		/* Don’t tell Susan! */
		span.arrow,
		span.times {
			background-position: center;
			background-repeat:   no-repeat;
			background-size:     var(--7px);
			block-size:          var(--7px);
			color:               transparent;
			display:             inline-block;
			inline-size:         var(--7px);
			vertical-align:      middle;
		}

		span.arrow { background-image: url('/assets/icons/right.svg') }
		span.times { background-image: url('/assets/icons/times.svg') }
	}
</style>
<script>
	const main = document.querySelector('main')
	const hash = window.location.hash.slice(1)

	const sections = new Set()

	// Update the hash while scrolling through.
	const observeSections = () => {
		main.querySelectorAll('[id]:not(figure)').forEach((id) => {
			if (id.closest('[inert]')) return

			const section = id.closest('section')

			if (section && !sections.has(section)) {
				sections.add(section)

				new IntersectionObserver(
					([entry]) => {
						(entry.isIntersecting)
							? history.replaceState(null, '', `#${section.querySelector('[id]')?.id}`)
							: ((section === ([...sections][0]) && entry.boundingClientRect.top >= 0)
								|| (section === ([...sections].at(-1)) && entry.boundingClientRect.top <= 0)) &&
									history.replaceState(null, '', window.location.pathname + window.location.search)
					},
					{
						rootMargin:
							section.matches('main > section:first-child')
								? '0% 0% -33%'
								: section.matches('main > section:last-child')
									? '0% 0% -50%'
									: '-50% 0%',
					},
				).observe(section)
			}
		})
	}

	// After any anchoring.
	(!hash)
		? observeSections()
		: setTimeout(observeSections, 1500)
</script>
<template webc:root="override" webc:bucket="default" webc:nokeep>
	<main :class="syllabusSemester($data)">
		<session-recording webc:if="$data.video"></session-recording>
		<template webc:nokeep @html="content"></template>
	</main>
</template>
