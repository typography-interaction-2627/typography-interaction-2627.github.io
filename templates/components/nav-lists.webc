<script webc:setup>
	export const getChannels = (data) => {
		const channels = parseHtml(data.collections.root.find(({ inputPath }) => inputPath.endsWith('content/syllabus.md')).content).querySelector('#channels')
		channels?.firstElementChild?.remove()

		channels?.querySelectorAll('li').forEach((item) => {
			const link = item.querySelector('a')
			const cite = link?.querySelector('cite')

			cite && (
				link.set_content(`<p>${cite.innerHTML}</p>`),
				item.set_content(link.outerHTML)
			)
		})

		return channels?.innerHTML ?? ''
	}
</script>
<style webc:bucket="components">
	details[name='nav'] {
		--family: 'Chicago';
		--size:   12;
		--wrap:   nowrap;

		/* … */
		p {
			margin-block:  var(---3px);
			overflow:      hidden;
			padding-block: var(--3px);
			text-overflow: ellipsis;
		}

		/* Page title for ToC. */
		> header {
			background-clip:   content-box;
			background-color:  var(--background);
			block-size:        2cap;
			display:           grid;
			inset-block-start: 0;
			padding-inline:    var(--1px); /* Room for parent border. */
			place-items:       center;
			position:          sticky;
			z-index:           1;

			/* Dotted line under. */
			&::before {
				background-color: var(--color);
				block-size:       var(--1px);
				content:          '';
				inset-block-end:  0;
				inset-inline:     var(--1px);
				mask:             var(--background--check);
				position:         absolute;
				z-index:          1;
			}

			a {
				--family: 'Geneva';
				--size:   9;

				inline-size:     fit-content;
				max-inline-size: calc(100% - 2ex);
			}
		}

		> :is(ol, ul) {
			--resolve: 1cap;

			column-gap:                2cap;
			display:                   grid;
			grid-template-columns:     minmax(0, 1fr);
			row-gap:                   var(--resolve);
			padding-block:             var(--resolve);
			padding-inline:            2ex;
			scroll-margin-block-start: calc(2 * var(--resolve));

			/* Room for indicator. */
			&:has([aria-current], a[href^='#']) { padding-inline-start: 3ex; }

			/* Pass columns down for Weeks/Projects with dates, external channels. */
			&:has(sub, a[href^="https"]) {
				grid-template-columns: minmax(0, 1fr) max-content;

				li {
					grid-column:           span 2;
					grid-template-columns: subgrid;

					a {
						align-items:           baseline;
						display:               inherit;
						grid-column:           inherit;
						grid-template-columns: inherit;
					}
				}
			}

			li {
				display:               inherit;
				grid-template-columns: inherit;
				justify-items:         start;
				position:              relative;
				row-gap:               var(--resolve);

				/* Current indicator. */
				&:has(> a[aria-current])::before {
					content:            '◆' / '';
					inset-inline-start: -2ex;
					position:           absolute;
					text-box:           trim-both cap alphabetic;
				}

				a {
					block-size:          var(--resolve);
					inline-size:         max-content;
					max-inline-size:     100%;
					scroll-margin-block: calc(3 * var(--resolve) + var(--3px));

					/* Externals. */
					&[href^="https"]::before {
						align-self:          end;
						background-image:    url('/assets/icons/&nearr.svg');
						background-position: center;
						background-repeat:   no-repeat;
						background-size:     var(--7px);
						block-size:          var(--7px);
						color:               transparent;
						content:             '↗' / '';
						inline-size:         var(--7px);
						order:               1;
					}

					/* Drafts, `inert` in-page. */
					&:not([href]) p {
						mask:           var(--background--check);
						pointer-events: none;
						user-select:    none;
					}

					/* Dates. */
					p:has(sub) {
						--family: 'Geneva';
						--size: var(--size--note);

						justify-self: end;
						text-align:   right;

						sub { display: block }
					}
				}

				/* ToC nesting. */
				> ol {
					display:               inherit;
					grid-template-columns: inherit;
					row-gap:               var(--resolve);

					a {
						--family: 'Geneva';
						--size:   var(--size--root);

						margin-inline-start: var(--resolve);
						max-inline-size:     calc(100% - var(--resolve));
						/* TODO Better way to do this? Without Safari always `…` */
					}

					ol {
						grid-template-columns: inherit;
						row-gap:               var(--resolve);

						a {
							--size: var(--size--note);

							margin-inline-start: calc(2 * var(--resolve));
							max-inline-size:     calc(100% - 2 * var(--resolve));
						}
					}
				}
			}
		}
	}
</style>
<script webc:bucket="default">
	const updateCurrentHash = () => {
		const currentHash = window.location.hash === '#' ? '' : window.location.hash
		const anchorLinks = [...document.querySelectorAll('nav a[href^="#"]')]

		anchorLinks.forEach((link) => {
			const current = currentHash && link.hash === currentHash

			link.ariaCurrent = current ? 'true' : null
			current && link.scrollIntoView({ block: 'nearest' })
		})

		currentHash || anchorLinks.find(link => link.hash)?.closest('ol')?.scrollIntoView({ block: 'start' })
	}

	updateCurrentHash()
	window.addEventListener('hashchange', updateCurrentHash)
	window.addEventListener('scrollhashchange', updateCurrentHash)
</script>
<template webc:nokeep webc:root="override">
	<ol webc:if="$data.collections[collection]">
		<li webc:for="item of $data.collections[collection]">
			<a :aria-current="item.url === $data.page.url && 'page'" :href="item.url">
				<p @html="item.data.title"></p>
				<p webc:if="collection != 'topics'"><sub @text="shortDate(item.data.date)"></sub></p>
			</a>
		</li>
	</ol>
	<ul webc:if="collection == 'channels'" @raw="getChannels($data)"></ul>
	<template webc:if="collection == 'contents'" webc:nokeep>
		<header>
			<a href="#">
				<p><em @html="$data.title"></em></p>
			</a>
		</header>
		<ol>
			<li webc:if="$data.video">
				<a href="#session-recording">
					<p>Session Recording</p>
				</a>
			</li>
			<template @raw="toc($data.content)" webc:nokeep></template>
		</ol>
	</template>
</template>
