<page-pattern></page-pattern>
<style>
	:root {
		block-size:  100%;
		inline-size: 100%;

		body {
			block-size:  inherit;
			display:     grid;
			inline-size: inherit;
		}

		/* Prevent double-zooming in `iframe`! */
		&.iframe {
			--vw--parent: var(--vw);
			--vh--parent: var(--vh);

			body {
				--vw: calc(var(--vw--parent) / var(--zoom, 1));
				--vw: calc(var(--vw--parent) / var(--zoom, 1));

				zoom: initial;
			}
		}

		/* No-JS basics. */
		&:has(ti-preview:not(:defined)) body {
			align-content:       center;
			padding-block-end:   calc(2 * var(--gutter));
			padding-block-start: var(--gutter);
			row-gap:             calc(2 * var(--gutter));

			&::before {
				background-color:   white;
				box-shadow:         var(--shadow--border), var(--shadow--double);
				content:            'You need JS enabled to see these editable previews!';
				inline-size:        max-content;
				inset-inline-start: round(down, 50%, var(--1px));
				max-inline-size:    var(--main);
				padding:            1ex;
				position:           relative;
				text-box:           trim-both cap alphabetic;
				translate:          round(-50%, var(--1px)) 0;
			}

			ti-preview {
				display:               grid;
				grid-template-columns: minmax(0, 1fr);
				inline-size:           var(--page);
				margin-inline-start:   round(down, calc((var(--vw) - var(--page)) / 2), var(--1px)); /* Land on-pattern. */
				row-gap:               var(--gutter);

				figcaption {
					background-color: var(--background);
					box-shadow:       var(--shadow--border), var(--shadow--single);
					inline-size:      fit-content;
					padding:          1ex;
					text-box:         trim-both cap alphabetic;
				}
			}
		}
	}
</style>
<script>
	const params = new URLSearchParams(window.location.search)

	const active = params.get('active')
	if (active) document.querySelector('ti-preview').setAttribute('current', active)

	const width = params.get('width')
	if (width) document.querySelector('ti-preview').style.setProperty('--editor-width', width)

	// Get parent page variables!
	if (window !== window.parent) {
		// TODO Inverse this so it removes?
		document.documentElement.classList.add('iframe')

		const root = document.documentElement
		const parentRoot = parent.document.documentElement

		const skip = ['--in-view', '--resolve'] // Animated/locally resolved, so never “inherit” them.

		let frame

		const syncParentVars = () => {
			cancelAnimationFrame(frame)

			frame = requestAnimationFrame(() => {
				Array.from(root.style).forEach((name) => root.style.removeProperty(name))

				const parentStyle = getComputedStyle(parentRoot)
				const rootStyle = getComputedStyle(root)

				// Read everything before writing anything to not cause recalculations.
				const changes = [...parentStyle]
					.filter((name) => name.startsWith('--') && !skip.includes(name))
					.map((name) => [name, parentStyle.getPropertyValue(name).trim(), rootStyle.getPropertyValue(name).trim()])
					.filter(([, value, current]) => value && value !== current)

				changes.forEach(([name, value]) => root.style.setProperty(name, value))
			})
		}

		syncParentVars()
		parent.addEventListener('resize', syncParentVars)
	}
</script>
<ti-preview base="../">
	<!-- TODO Add link back to the topic page! -->
	<figure webc:keep webc:root webc:for="file of example.files.filter(({ filename }) => ['.html', '.css', '.js'].some((ext) => filename.endsWith(ext)))">
		<figcaption @text="file.filename"></figcaption>
		<pre @nested="true">
			<code @text="file.contents"></code>
		</pre>
	</figure>
</ti-preview>
