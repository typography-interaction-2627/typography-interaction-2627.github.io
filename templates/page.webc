<page-pattern></page-pattern>
<script>
	let scrollTimeout
	let previousScrollY = scrollY
	let scrollDirection

	window.addEventListener('scroll', () => {
		scrollDirection = Math.sign(scrollY - previousScrollY)
		previousScrollY = scrollY

		clearTimeout(scrollTimeout)

		scrollTimeout = setTimeout(() => {
			const style = getComputedStyle(document.documentElement)
			const scaling = parseFloat(style.getPropertyValue('--scaling')) * (parseFloat(style.getPropertyValue('--zoom')) || 1)
			const rounding = scrollDirection > 0 ? Math.ceil : Math.floor

			scrollTo({ top: rounding(scrollY / scaling) * scaling })
		}, 200)
	})
</script>
<template webc:bucket="components" webc:nokeep>
	<style>
		:where(:root) {
			/* TODO Measure scrollbar in JS for even `100vw` centering! */
			scrollbar-gutter: both;
			overflow-y:       scroll;

			/* TODO Style scrollbars for black/white! */

			/* Invert. */
			::selection {
				color:            var(--background);
				background-color: var(--color);
			}

			@media (prefers-reduced-motion: no-preference) { scroll-behavior: smooth }
		}

		body {
			inline-size:    round(down, 100%, var(--1px)); /* On-pattern. */
			padding-bottom: var(--break);
		}
	</style>
	<nav-bar></nav-bar>
	<page-header></page-header>
	<main-content :@content="content"></main-content>
	<license-footer></license-footer>
</template>
