{
	"dependencies": {
		"@11ty/eleventy-img": "^7.0.0",
		"@11ty/eleventy-plugin-webc": "0.12.0-beta.7",
		"@11ty/webc": "0.12.0-beta.2",
		"@awesome.me/buildawesome": "4.0.0-alpha.10",
		"@mdit-vue/plugin-component": "^3.0.2",
		"@parsons/ti-preview": "^0.0.44",
		"markdown-it": "^15.0.0",
		"markdown-it-abbr": "^2.0.0",
		"markdown-it-anchor": "^9.2.1",
		"markdown-it-attrs": "^5.0.1",
		"markdown-it-header-sections": "^1.0.0",
		"node-html-parser": "^9.0.1",
		"puppeteer": "^25.8.0",
		"striptags": "^3.2.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"onFail": "download",
			"version": ">=26.3.0"
		}
	},
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks && pnpm fonts",
		"clean": "node -e \"require('fs').rmSync('_site', { recursive: true, force: true })\"",
		"fonts": "node fetch-fonts.js",
		"build": "pnpm fonts && pnpm clean && buildawesome",
		"serve": "pnpm clean && buildawesome --serve --port=80 --incremental",
		"lint": "eslint . --fix"
	},
	"type": "module",
	"devDependencies": {
		"@html-eslint/eslint-plugin": "^0.66.1",
		"@html-eslint/parser": "^0.66.1",
		"dotenv": "^17.4.2",
		"eslint": "^10.11.0",
		"eslint-plugin-html": "^8.2.1",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-perfectionist": "^5.12.1",
		"jsonc-eslint-parser": "^3.3.0"
	}
}
